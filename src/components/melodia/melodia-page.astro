---
import Layout from "../../layouts/Layout.astro";
import { getLocaleFromPath, getLocalizedPath } from "../../utils/i18n";

const locale = getLocaleFromPath(Astro.url.pathname);
const pageHref = getLocalizedPath("/melodia/page", locale);
const servicesHref = getLocalizedPath("/services", locale);
const loadingLabel = locale === "es" ? "Cargando…" : "Loading…";
---

<Layout
  title="Melodia — Code with CZ"
  description="Melodía de Bolivia client review — four homepage art directions."
  url={Astro.url.href}
  ambientSubtle
>
  <div class="relative z-10 mx-auto min-h-dvh max-w-screen-xl px-5 pb-12 pt-24 font-sans sm:px-6 sm:pt-28 md:px-12 lg:px-16 xl:px-20">
    <main role="main" class="max-w-2xl">
      <p class="text-sm font-semibold tracking-wide" style="color: var(--primary);">Melodia</p>
      <h1 class="mt-2 text-3xl font-bold tracking-tight sm:text-4xl" style="color: var(--text-primary);">
        Project hub
      </h1>
      <p class="mt-3 text-base leading-relaxed" style="color: var(--text-secondary);">
        Client review for Melodía de Bolivia. Compare four locked homepage directions, then keep the mixer as an archive.
      </p>

      <ul class="mt-10 space-y-4">
        <li>
          <a
            href={pageHref}
            data-localized-href="/melodia/page"
            data-melodia-nav-loading
            class="group relative block rounded-2xl border px-5 py-4 transition-colors"
            style="border-color: var(--border-subtle); background: var(--surface-quiet);"
          >
            <span class="text-base font-semibold" style="color: var(--text-primary);">Page</span>
            <span class="mt-1 block text-sm" style="color: var(--text-muted);">
              Four art directions to vote on: Entrada, Tejido, Toronto ↔ Bolivia, and Escenario. Header and footer stay locked together.
            </span>
            <span class="melodia-hub__nav-status" data-melodia-nav-status hidden aria-live="polite">
              <span class="melodia-hub__nav-spinner" aria-hidden="true"></span>
              {loadingLabel}
            </span>
          </a>
        </li>
        <li>
          <a
            href="/melodia/navbar-theme-playground.html"
            class="group block rounded-2xl border px-5 py-4 transition-colors"
            style="border-color: var(--border-subtle); background: var(--surface-quiet);"
          >
            <span class="text-base font-semibold" style="color: var(--text-primary);">Old combinations</span>
            <span class="mt-1 block text-sm" style="color: var(--text-muted);">
              Archive of the earlier menu × footer × theme mixer.
            </span>
          </a>
        </li>
      </ul>

      <p class="mt-10 text-sm">
        <a href={servicesHref} data-localized-href="/services" class="underline-offset-2 hover:underline" style="color: var(--text-muted);">
          ← Back to services
        </a>
      </p>
    </main>
  </div>
</Layout>

<script>
  const pageLink = document.querySelector("[data-melodia-nav-loading]");
  const status = document.querySelector<HTMLElement>("[data-melodia-nav-status]");

  function clearNavigating() {
    pageLink?.classList.remove("is-navigating");
    pageLink?.removeAttribute("aria-busy");
    if (status) status.hidden = true;
  }

  pageLink?.addEventListener("click", (event: MouseEvent) => {
    if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
    if (event.button !== 0) return;
    pageLink.classList.add("is-navigating");
    pageLink.setAttribute("aria-busy", "true");
    if (status) status.hidden = false;
  });

  window.addEventListener("pageshow", clearNavigating);
</script>

<style>
  .melodia-hub__nav-status {
    position: absolute;
    top: 1rem;
    right: 1.25rem;
    display: none;
    align-items: center;
    gap: 8px;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--primary);
  }

  a[data-melodia-nav-loading].is-navigating .melodia-hub__nav-status {
    display: inline-flex;
  }

  .melodia-hub__nav-spinner {
    width: 12px;
    height: 12px;
    border-radius: 999px;
    border: 1.5px solid color-mix(in srgb, var(--primary) 30%, transparent);
    border-top-color: var(--primary);
    animation: melodia-hub-spin 0.65s linear infinite;
  }

  a[data-melodia-nav-loading].is-navigating {
    opacity: 0.72;
    pointer-events: none;
  }

  @keyframes melodia-hub-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .melodia-hub__nav-spinner {
      animation: none;
      border-top-color: var(--primary);
      border-right-color: var(--primary);
    }
  }
</style>
