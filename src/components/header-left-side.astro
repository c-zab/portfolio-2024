---
import Navbar from "../components/navbar.astro";
import ThemeLanguageControls from "./theme-language-controls.astro";
import { getTranslation, getLocaleFromPath } from "../utils/i18n";

const locale = getLocaleFromPath(Astro.url.pathname);
const t = (key: string) => getTranslation(locale, key);
---

<header class="flex flex-col items-center">
  <div class="flex flex-col items-center">
    <h1
      class="ml11 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl dark:text-slate-300"
      aria-label={t("common.name")}
    >
      <span class="text-wrapper" aria-hidden="true">
        <span class="line line1"></span>
        <span class="letters">{t("common.name")}</span>
      </span>
    </h1>
    <h2
      data-hero-title
      class="hero-enter mt-3 text-lg font-medium tracking-tight text-slate-900 sm:text-xl dark:text-slate-300"
    >
      {t("common.title")}
    </h2>
    <p
      data-hero-bio
      class="hero-enter mt-4 max-w-lg leading-normal text-slate-600 dark:text-slate-400"
    >
      {t("header.description")}
    </p>
    <div data-hero-chrome class="hero-enter mt-6 flex w-full flex-col items-center">
      <div class="flex justify-center">
        <ThemeLanguageControls />
      </div>
      <div class="mt-8">
        <Navbar />
      </div>
    </div>
  </div>
</header>

<script>
  import anime from "animejs";

  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const textWrapper = document.querySelector(".ml11 .letters");
  const enterEls = document.querySelectorAll<HTMLElement>(".hero-enter");

  if (reducedMotion) {
    enterEls.forEach((el) => {
      el.style.opacity = "1";
      el.style.transform = "none";
    });
  } else {
    enterEls.forEach((el) => {
      el.style.opacity = "0";
    });

    if (textWrapper) {
      textWrapper.innerHTML = (textWrapper.textContent ?? "").replace(
        /([^\x00-\x80]|\w)/g,
        "<span class='letter'>$&</span>"
      );

      anime
        .timeline({
          easing: "easeOutExpo",
          duration: 500,
        })
        .add({
          targets: ".ml11 .line",
          scaleY: [0, 1],
          opacity: [0.5, 1],
          delay: 500,
        })
        .add({
          targets: ".ml11 .line",
          translateX: [0, textWrapper.getBoundingClientRect().width + 10],
          duration: 1000,
        })
        .add(
          {
            targets: ".ml11 .letter",
            opacity: [0, 1],
            duration: 600,
            offset: "-=775",
            delay: (_el: unknown, i: number) => 40 * (i + 1),
          },
          "-=900"
        )
        .add(
          {
            targets: "[data-hero-title]",
            opacity: [0, 1],
            translateY: [12, 0],
            duration: 400,
          },
          "-=200"
        )
        .add(
          {
            targets: "[data-hero-bio]",
            opacity: [0, 1],
            translateY: [12, 0],
            duration: 400,
          },
          "-=200"
        )
        .add(
          {
            targets: "[data-hero-chrome]",
            opacity: [0, 1],
            duration: 400,
          },
          "-=150"
        )
        .add(
          {
            targets: "[data-tech-marquee]",
            opacity: [0, 1],
            duration: 500,
          },
          "-=100"
        );
    }

    anime({
      targets: ".ml11 .line",
      opacity: [0, 1],
      easing: "linear",
      loop: true,
      duration: 1000,
    });
  }
</script>

<style>
  .ml11 .text-wrapper {
    position: relative;
    display: inline-block;
    padding-top: 0.1em;
    padding-right: 0.05em;
    padding-bottom: 0.15em;
  }

  .ml11 .line {
    opacity: 0;
    position: absolute;
    left: 0;
    height: 100%;
    width: 3px;
    background-color: #0f172a;
    transform-origin: 0 50%;
    transition: background-color 0.3s ease;
  }

  .dark .ml11 .line {
    background-color: #cbd5e1;
  }

  .ml11 .line1 {
    top: 0;
    left: 0;
  }

  .ml11 :global(.letter) {
    display: inline-block;
    line-height: 1em;
  }

  .hero-enter {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-enter {
      opacity: 1;
      transform: none;
    }

    .ml11 .line {
      display: none;
    }
  }
</style>
