---
import Layout from "../../layouts/Layout.astro";
import { getLocaleFromPath, getLocalizedPath } from "../../utils/i18n";

const locale = getLocaleFromPath(Astro.url.pathname);
const melodiaHref = getLocalizedPath("/melodia", locale);
const copy =
  locale === "es"
    ? {
        expand: "Expandir",
        exit: "Salir",
        back: "← Volver a Melodia",
        loading: "Cargando vista previa…",
      }
    : {
        expand: "Expand",
        exit: "Exit",
        back: "← Back to Melodia",
        loading: "Loading preview…",
      };
---

<Layout
  title="Melodia page — Code with CZ"
  description="Four locked homepage art directions for Melodía de Bolivia."
  url={Astro.url.href}
  ambientSubtle
>
  <div class="melodia-page relative z-10 mx-auto min-h-dvh max-w-[1400px] px-4 pb-8 pt-24 font-sans sm:px-6 sm:pt-28">
    <main role="main">
      <div class="mb-5 flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="text-sm font-semibold tracking-wide" style="color: var(--primary);">Melodia</p>
          <h1 class="mt-1 text-2xl font-bold tracking-tight sm:text-3xl" style="color: var(--text-primary);">
            Page
          </h1>
        </div>
        <p class="text-sm">
          <a
            href={melodiaHref}
            data-localized-href="/melodia"
            class="underline-offset-2 hover:underline"
            style="color: var(--text-muted);"
          >
            {copy.back}
          </a>
        </p>
      </div>

      <div class="mb-3 flex flex-wrap items-center justify-end gap-2">
        <button
          type="button"
          data-melodia-expand
          class="melodia-page__fs inline-flex items-center gap-2 rounded-full border px-4 py-2 text-sm font-medium transition-colors"
          style="border-color: var(--border-subtle); color: var(--text-primary); background: var(--surface-quiet);"
          aria-pressed="false"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M8 3H3v5M16 3h5v5M8 21H3v-5M16 21h5v-5"></path>
          </svg>
          <span data-melodia-expand-label>{copy.expand}</span>
        </button>
      </div>

      <div
        data-melodia-preview
        class="melodia-page__frame is-loading overflow-hidden rounded-2xl border"
        style="border-color: var(--border-subtle); background: #0a0a0a;"
        aria-busy="true"
      >
        <div class="melodia-page__exitbar" hidden data-melodia-exitbar>
          <button
            type="button"
            data-melodia-expand-close
            class="melodia-page__close"
          >
            {copy.exit}
          </button>
        </div>
        <div class="melodia-page__loading" data-melodia-loading role="status" aria-live="polite">
          <span class="melodia-page__spinner" aria-hidden="true"></span>
          <span>{copy.loading}</span>
        </div>
        <iframe
          title="Melodía de Bolivia — page preview"
          src="/melodia/directions-playground.html?d=tejido&v=20261006"
          class="melodia-page__iframe block w-full border-0"
          loading="eager"
          data-melodia-iframe
        ></iframe>
      </div>
    </main>
  </div>
</Layout>

<script define:vars={{ expandLabel: copy.expand, exitLabel: copy.exit }}>
  const page = document.querySelector(".melodia-page");
  const frame = document.querySelector("[data-melodia-preview]");
  const expandBtn = document.querySelector("[data-melodia-expand]");
  const closeBtn = document.querySelector("[data-melodia-expand-close]");
  const exitBar = document.querySelector("[data-melodia-exitbar]");
  const label = document.querySelector("[data-melodia-expand-label]");
  const iframe = document.querySelector("[data-melodia-iframe]");
  let lastContentHeight = 0;

  function clearLoading() {
    if (!frame) return;
    frame.classList.remove("is-loading");
    frame.setAttribute("aria-busy", "false");
  }

  if (iframe) {
    if (iframe.contentDocument?.readyState === "complete") {
      clearLoading();
    } else {
      iframe.addEventListener("load", clearLoading, { once: true });
    }
  }

  function isExpanded() {
    return frame?.classList.contains("is-expanded") ?? false;
  }

  function defaultIframeHeight() {
    const mobile = window.matchMedia("(max-width: 767px)").matches;
    if (mobile) return Math.round(window.innerHeight - 9.5 * 16);
    return Math.min(900, Math.round(window.innerHeight - 10 * 16));
  }

  function applyIframeHeight(contentHeight) {
    if (!iframe || !frame) return;
    lastContentHeight = contentHeight;
    const next = Math.max(280, Math.ceil(contentHeight));

    if (isExpanded()) {
      const vh = window.innerHeight;
      // Avoid a tall black void under short web previews in fullscreen
      if (next + 56 < vh) {
        frame.classList.add("is-hug");
        iframe.style.height = `${next}px`;
      } else {
        frame.classList.remove("is-hug");
        iframe.style.height = "";
      }
      return;
    }

    frame.classList.remove("is-hug");
    const maxH = Math.max(defaultIframeHeight(), 520);
    iframe.style.height = `${Math.min(next, maxH)}px`;
  }

  function setExpanded(on) {
    if (!frame) return;
    frame.classList.toggle("is-expanded", on);
    page?.classList.toggle("is-preview-expanded", on);
    document.body.classList.toggle("melodia-preview-locked", on);
    if (label) label.textContent = on ? exitLabel : expandLabel;
    expandBtn?.setAttribute("aria-pressed", on ? "true" : "false");
    if (exitBar) exitBar.hidden = !on;
    if (lastContentHeight) applyIframeHeight(lastContentHeight);
    else if (on) {
      frame.classList.remove("is-hug");
      if (iframe) iframe.style.height = "";
    }
  }

  expandBtn?.addEventListener("click", () => setExpanded(!isExpanded()));
  closeBtn?.addEventListener("click", () => setExpanded(false));

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && isExpanded()) setExpanded(false);
  });

  window.addEventListener("message", (event) => {
    if (event.origin !== window.location.origin) return;
    const data = event.data;
    if (!data || data.type !== "melodia-preview-height" || typeof data.height !== "number") return;
    applyIframeHeight(data.height);
  });
</script>

<style>
  .melodia-page__frame {
    position: relative;
  }

  .melodia-page__loading {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 14px;
    background: #0a0a0a;
    color: rgba(255, 255, 255, 0.72);
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transition: opacity 180ms ease, visibility 180ms ease;
  }

  .melodia-page__frame.is-loading .melodia-page__loading {
    opacity: 1;
    visibility: visible;
  }

  .melodia-page__spinner {
    width: 28px;
    height: 28px;
    border-radius: 999px;
    border: 2px solid rgba(255, 255, 255, 0.16);
    border-top-color: rgba(255, 255, 255, 0.85);
    animation: melodia-page-spin 0.7s linear infinite;
  }

  @keyframes melodia-page-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .melodia-page__spinner {
      animation: none;
      border-top-color: rgba(255, 255, 255, 0.55);
      border-right-color: rgba(255, 255, 255, 0.55);
    }

    .melodia-page__loading {
      transition: none;
    }
  }

  .melodia-page__iframe {
    height: min(900px, calc(100dvh - 10rem));
    min-height: 560px;
  }

  .melodia-page__exitbar {
    display: none;
  }

  /* Escape the page z-10 stacking context so expand sits above SiteNav */
  .melodia-page.is-preview-expanded {
    z-index: auto;
  }

  .melodia-page__frame.is-expanded {
    position: fixed;
    inset: 0;
    z-index: 100;
    width: 100%;
    height: 100dvh;
    border-radius: 0;
    border: 0;
    background: #111;
    display: flex;
    flex-direction: column;
  }

  .melodia-page__frame.is-expanded .melodia-page__exitbar {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: flex-end;
    gap: 8px;
    padding:
      max(8px, env(safe-area-inset-top))
      max(12px, env(safe-area-inset-right))
      8px
      max(12px, env(safe-area-inset-left));
    background: #111;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }

  .melodia-page__frame.is-expanded .melodia-page__close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
    padding: 8px 14px;
    font-size: 13px;
    font-weight: 600;
  }

  .melodia-page__frame.is-expanded .melodia-page__iframe {
    flex: 1 1 auto;
    min-height: 0;
    height: auto;
  }

  .melodia-page__frame.is-expanded.is-hug {
    justify-content: flex-start;
  }

  .melodia-page__frame.is-expanded.is-hug .melodia-page__iframe {
    flex: 0 0 auto;
  }

  :global(body.melodia-preview-locked) {
    overflow: hidden;
  }

  :global(body.melodia-preview-locked .site-nav-wrap) {
    visibility: hidden;
    pointer-events: none;
  }

  .melodia-page__fs:hover {
    border-color: color-mix(in srgb, var(--primary) 45%, var(--border-subtle));
    color: var(--primary);
  }

  @media (max-width: 767px) {
    .melodia-page__iframe {
      height: calc(100dvh - 9.5rem);
      min-height: 520px;
    }
  }
</style>
