---
import Navbar from "../components/navbar.astro";
import { getLocaleFromPath, getLocalizedPath, getTranslation } from "../utils/i18n";
import { accentize } from "../utils/accent-text";

const locale = getLocaleFromPath(Astro.url.pathname);
const t = (key: string) => getTranslation(locale, key);
---

<header class="flex w-full max-w-full flex-col items-center px-1">
  <div class="flex w-full max-w-full flex-col items-center">
    <h1
      class="typed text-[clamp(1.7rem,7.2vw,3rem)] font-bold tracking-tight"
      style="color: var(--text-primary);"
      aria-label={t("common.name")}
      data-hero-name
    >
      <span class="typed__text" aria-hidden="true">{t("common.name")}</span>
    </h1>
    <h2
      data-hero-title
      data-i18n="common.title"
      class="hero-enter mt-3 text-lg font-medium tracking-tight sm:text-xl"
      style="color: var(--text-primary);"
    >
      {t("common.title")}
    </h2>
    <p
      data-hero-bio
      data-i18n-accent="header.description"
      class="hero-enter mt-4 max-w-lg leading-normal"
      style="color: var(--text-secondary);"
      set:html={accentize(t("header.description"))}
    />
    <div data-hero-chrome class="hero-enter mt-8 flex flex-col items-center gap-7">
      <div class="flex flex-wrap items-center justify-center gap-3">
        <button type="button" data-contact-open="discovery" class="btn-cta" data-i18n="services.heroPrimary">
          {t("services.heroPrimary")}
        </button>
        <a href={getLocalizedPath("/services", locale)} data-localized-href="/services" class="btn-ghost">
          <span data-i18n="header.servicesCta">{t("header.servicesCta")}</span>
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="btn-ghost__arrow h-4 w-4"
            aria-hidden="true"
          >
            <path d="M5 12h14M12 5l7 7-7 7"></path>
          </svg>
        </a>
      </div>
      <Navbar />
    </div>
  </div>
</header>

<script>
  import anime from "animejs";
  import { createTypewriter } from "../utils/typewriter";

  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const nameEl = document.querySelector<HTMLElement>("[data-hero-name]");
  const enterEls = document.querySelectorAll<HTMLElement>(".hero-enter");

  function showHeroSettled() {
    enterEls.forEach((el) => {
      el.style.opacity = "1";
      el.style.transform = "none";
    });
    document.documentElement.classList.add("hero-ready");
  }

  if (reducedMotion || !nameEl) {
    if (nameEl) createTypewriter(nameEl);
    showHeroSettled();
  } else {
    enterEls.forEach((el) => {
      el.style.opacity = "0";
    });

    const typewriter = createTypewriter(nameEl, { startDelay: 500 });

    // Timers and anime can stall (hidden tab, competing tweens). Match SiteNav: always reveal.
    const heroFallback = window.setTimeout(() => {
      typewriter.finish();
      showHeroSettled();
    }, 4500);

    typewriter.done.then(() => {
      anime
        .timeline({
          easing: "easeOutExpo",
          duration: 400,
          complete: () => {
            window.clearTimeout(heroFallback);
            showHeroSettled();
          },
        })
        .add({
          targets: "[data-hero-title]",
          opacity: [0, 1],
          translateY: [12, 0],
        })
        .add(
          {
            targets: "[data-hero-bio]",
            opacity: [0, 1],
            translateY: [12, 0],
          },
          "-=200"
        )
        .add(
          {
            targets: "[data-hero-chrome]",
            opacity: [0, 1],
          },
          "-=150"
        )
        .add(
          {
            targets: "[data-tech-marquee]",
            opacity: [0, 1],
            duration: 500,
          },
          "-=100"
        );
    });
  }
</script>

<style>
  .hero-enter {
    opacity: 0;
  }

  .btn-ghost:hover .btn-ghost__arrow {
    transform: translateX(2px);
  }

  :global(html.hero-ready) .hero-enter {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-enter {
      opacity: 1;
      transform: none;
    }
  }
</style>
