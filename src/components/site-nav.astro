---
import { getLocaleFromPath, getLocalizedPath, getPathWithoutLocale, getTranslation } from "../utils/i18n";

const currentLocale = getLocaleFromPath(Astro.url.pathname);
const t = (key: string) => getTranslation(currentLocale, key);
const pathWithoutLocale = getPathWithoutLocale(Astro.url.pathname);
const isHome = pathWithoutLocale === "/";
const isServices = pathWithoutLocale.startsWith("/services");
const homeHref = getLocalizedPath("/", currentLocale);
---

<header class="site-nav-wrap">
  <div class="site-nav">
    <a
      href={homeHref}
      data-localized-href="/"
      data-cz-logo
      class="cz-logo"
      aria-label={t("common.name")}
      title={t("navigation.home")}
    >
      <span>CZ</span>
    </a>

    <div data-nav-utils class="nav-utils">
      <div data-language-switcher class="nav-lang">
        <a
          href={getLocalizedPath(pathWithoutLocale, "en")}
          data-locale="en"
          class:list={["nav-lang__link", { "is-active": currentLocale === "en" }]}
          aria-label="Switch to English"
          aria-current={currentLocale === "en" ? "true" : undefined}
        >
          EN
        </a>
        <span class="nav-lang__slash">/</span>
        <a
          href={getLocalizedPath(pathWithoutLocale, "es")}
          data-locale="es"
          class:list={["nav-lang__link", { "is-active": currentLocale === "es" }]}
          aria-label="Switch to Español"
          aria-current={currentLocale === "es" ? "true" : undefined}
        >
          ES
        </a>
      </div>

      <span class="nav-utils__divider" aria-hidden="true"></span>

      <button
        type="button"
        data-theme-toggle
        class="nav-theme"
        aria-label="Toggle theme"
        title="Toggle theme"
      >
        <svg
          class="nav-theme__icon nav-theme__icon--sun"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
        </svg>
        <svg
          class="nav-theme__icon nav-theme__icon--moon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8Z"></path>
        </svg>
      </button>
    </div>

    <button
      type="button"
      class="nav-toggle"
      data-nav-toggle
      aria-expanded="false"
      aria-controls="site-menu"
      data-i18n-aria="navigation.menu"
      aria-label={t("navigation.menu")}
    >
      <span class="nav-toggle__bars" aria-hidden="true">
        <span></span>
        <span></span>
      </span>
    </button>

    <div class="site-nav__end" id="site-menu">
      <nav class="site-nav__links" aria-label="Primary">
        <a
          href={homeHref}
          data-localized-href="/"
          class:list={["nav-link", { "is-active": isHome }]}
          aria-current={isHome ? "page" : undefined}
        >
          <span data-i18n="navigation.home">{t("navigation.home")}</span>
        </a>
        <button
          type="button"
          class="nav-link is-disabled nav-link--blog"
          data-nav="blog"
          disabled
          aria-disabled="true"
          title={t("navigation.comingSoon")}
          data-i18n-title="navigation.comingSoon"
        >
          <span data-i18n="navigation.blog">{t("navigation.blog")}</span>
        </button>
        <a
          href={getLocalizedPath("/services", currentLocale)}
          data-localized-href="/services"
          class:list={["nav-link", { "is-active": isServices }]}
          aria-current={isServices ? "page" : undefined}
        >
          <span data-i18n="navigation.services">{t("navigation.services")}</span>
        </a>
        <button
          type="button"
          class="nav-link"
          data-contact-open
          data-i18n-aria="navigation.contact"
          aria-label={t("navigation.contact")}
        >
          <span data-i18n="navigation.contact">{t("navigation.contact")}</span>
        </button>
      </nav>
    </div>
  </div>
</header>

<script>
  import anime from "animejs";
  import { getLocaleFromPath, getPathWithoutLocale, getTranslation } from "../utils/i18n";
  import { initLocaleSwitcher } from "../utils/apply-locale";
  import { initThemeToggle } from "../utils/theme";

  initLocaleSwitcher();
  initThemeToggle();

  const nav = document.querySelector<HTMLElement>(".site-nav");
  const logo = document.querySelector<HTMLElement>("[data-cz-logo]");
  const toggle = document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
  const menu = document.getElementById("site-menu");
  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const compactQuery = window.matchMedia("(max-width: 767px)");

  function menuLabel(open: boolean) {
    return getTranslation(getLocaleFromPath(window.location.pathname), open ? "navigation.closeMenu" : "navigation.menu");
  }

  function setMenuOpen(open: boolean) {
    nav?.classList.toggle("is-open", open);
    toggle?.setAttribute("aria-expanded", open ? "true" : "false");
    toggle?.setAttribute("aria-label", menuLabel(open));
    document.body.classList.toggle("nav-locked", open);
  }

  function settleNavIntro() {
    nav?.classList.add("is-intro-done");
  }

  if (nav) {
    if (prefersReducedMotion) {
      settleNavIntro();
    } else {
      const introItems = compactQuery.matches
        ? [nav.querySelector(".cz-logo"), toggle]
        : [nav.querySelector(".cz-logo"), ...nav.querySelectorAll(".nav-link"), nav.querySelector(".nav-utils")];

      const items = introItems.filter((el): el is HTMLElement => el instanceof HTMLElement);

      items.forEach((el) => {
        el.style.opacity = "0";
        el.style.transform = "translateY(-10px)";
      });

      anime({
        targets: items,
        opacity: (el: HTMLElement) => (el.matches(".is-disabled, :disabled") ? [0, 0.45] : [0, 1]),
        translateY: [-10, 0],
        delay: anime.stagger(70, { start: 60 }),
        duration: 560,
        easing: "easeOutExpo",
        complete: settleNavIntro,
      });
    }
  }

  toggle?.addEventListener("click", () => {
    setMenuOpen(!nav?.classList.contains("is-open"));
  });

  menu?.addEventListener("click", (event) => {
    const target = event.target as HTMLElement | null;
    const item = target?.closest<HTMLElement>(
      "a.nav-link, button.nav-link:not(.is-disabled):not(:disabled), [data-contact-open], .nav-lang__link, .nav-theme"
    );
    if (item) setMenuOpen(false);
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && nav?.classList.contains("is-open")) {
      setMenuOpen(false);
      toggle?.focus();
    }
  });

  document.addEventListener("click", (event) => {
    if (!nav?.classList.contains("is-open")) return;
    const target = event.target as Node | null;
    if (target && !nav.contains(target)) setMenuOpen(false);
  });

  compactQuery.addEventListener("change", (event) => {
    if (!event.matches) setMenuOpen(false);
  });

  logo?.addEventListener("click", (event) => {
    if (getPathWithoutLocale(window.location.pathname) === "/") {
      event.preventDefault();
    }

    setMenuOpen(false);
    logo.classList.remove("is-pulsing");
    void logo.offsetWidth;
    logo.classList.add("is-pulsing");

    if (prefersReducedMotion) return;

    const rect = logo.getBoundingClientRect();
    const wave = document.createElement("span");
    wave.className = "logo-wave";
    wave.style.left = `${rect.left + rect.width / 2}px`;
    wave.style.top = `${rect.top + rect.height / 2}px`;
    document.body.appendChild(wave);
    wave.addEventListener("animationend", () => wave.remove(), { once: true });
  });
</script>

<style>
  .site-nav-wrap {
    position: fixed;
    top: 0;
    right: 0;
    left: 0;
    z-index: 40;
    display: flex;
    justify-content: center;
    padding: 14px 16px 20px;
    pointer-events: none;
  }

  .site-nav-wrap::before {
    content: "";
    position: absolute;
    inset: 0 0 0 0;
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--canvas) 92%, transparent) 0%,
      color-mix(in srgb, var(--canvas) 72%, transparent) 55%,
      transparent 100%
    );
    pointer-events: none;
  }

  .site-nav {
    pointer-events: auto;
    position: relative;
    display: flex;
    width: min(1180px, 100%);
    align-items: center;
    justify-content: flex-start;
    gap: 8px;
    padding: 5px 8px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--glass-bg) 88%, var(--canvas));
    border: 1px solid var(--glass-border);
    box-shadow:
      0 10px 28px rgba(15, 23, 42, 0.07),
      inset 0 1px 0 rgba(255, 255, 255, 0.35);
    backdrop-filter: blur(20px) saturate(1.15);
    -webkit-backdrop-filter: blur(20px) saturate(1.15);
  }

  .site-nav__end {
    display: flex;
    min-width: 0;
    flex: 1;
    align-items: center;
    justify-content: flex-end;
    gap: 10px;
    order: 2;
  }

  [data-nav-utils] {
    order: 3;
  }

  .nav-toggle {
    order: 4;
  }

  .cz-logo {
    order: 1;
  }

  :global(html.dark) .site-nav {
    background: color-mix(in srgb, var(--glass-bg) 92%, var(--canvas));
    box-shadow:
      0 12px 32px rgba(0, 0, 0, 0.28),
      inset 0 1px 0 rgba(255, 255, 255, 0.05);
  }

  .site-nav:not(.is-intro-done) .cz-logo,
  .site-nav:not(.is-intro-done) .nav-toggle,
  .site-nav:not(.is-intro-done) .nav-link,
  .site-nav:not(.is-intro-done) .nav-utils {
    opacity: 0;
  }

  .site-nav.is-intro-done .cz-logo,
  .site-nav.is-intro-done .nav-toggle,
  .site-nav.is-intro-done .nav-link:not(.is-disabled):not(:disabled),
  .site-nav.is-intro-done .nav-utils {
    opacity: 1;
    transform: none;
  }

  .site-nav.is-intro-done .nav-link.is-disabled,
  .site-nav.is-intro-done .nav-link:disabled {
    opacity: 0.45;
    transform: none;
  }

  .nav-link--blog {
    display: inline-flex;
  }

  .site-nav__links {
    display: flex;
    align-items: center;
    gap: 2px;
  }

  .cz-logo {
    position: relative;
    display: grid;
    width: 38px;
    height: 38px;
    flex-shrink: 0;
    place-items: center;
    overflow: visible;
    isolation: isolate;
    border-radius: 10px;
    background: transparent;
    color: var(--primary);
    text-decoration: none;
    border: none;
    box-shadow: none;
    transition:
      transform 180ms ease,
      background 220ms ease,
      color 220ms ease;
  }

  .cz-logo span {
    position: relative;
    z-index: 2;
    display: block;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    line-height: 1;
    text-indent: 0.14em;
  }

  .cz-logo:hover {
    transform: translateY(-1px);
    background: var(--surface-quiet);
  }

  :global(html.dark) .cz-logo:hover {
    background: var(--surface-quiet);
  }

  .cz-logo:active {
    transform: scale(0.96);
  }

  .nav-toggle {
    display: none;
    width: 44px;
    height: 44px;
    flex-shrink: 0;
    place-items: center;
    border: 1px solid var(--glass-border);
    border-radius: 999px;
    background: var(--glass-bg);
    color: var(--text-primary);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.45),
      0 10px 24px rgba(15, 23, 42, 0.06);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    cursor: pointer;
    appearance: none;
    padding: 0;
  }

  .nav-toggle__bars {
    position: relative;
    display: block;
    width: 16px;
    height: 12px;
  }

  .nav-toggle__bars span {
    position: absolute;
    left: 0;
    right: 0;
    height: 1.5px;
    border-radius: 999px;
    background: currentColor;
    transition: transform 220ms ease, top 220ms ease;
  }

  .nav-toggle__bars span:first-child {
    top: 3px;
  }

  .nav-toggle__bars span:last-child {
    top: 9px;
  }

  .site-nav.is-open .nav-toggle__bars span:first-child {
    top: 6px;
    transform: rotate(45deg);
  }

  .site-nav.is-open .nav-toggle__bars span:last-child {
    top: 6px;
    transform: rotate(-45deg);
  }

  .cz-logo::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(
      circle at center,
      color-mix(in srgb, var(--teal-signal) 28%, transparent) 0%,
      color-mix(in srgb, var(--sky-atmo-bright) 12%, transparent) 42%,
      transparent 68%
    );
    opacity: 0;
    pointer-events: none;
    transition: opacity 220ms ease;
  }

  .cz-logo:hover::after {
    opacity: 0.45;
  }

  .cz-logo.is-pulsing::after {
    opacity: 0.55;
    animation: logo-click-pulse 700ms cubic-bezier(0.2, 0.75, 0.3, 1);
  }

  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 40px;
    padding: 0 16px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--text-muted);
    font-family: inherit;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.01em;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    appearance: none;
    cursor: pointer;
    transition:
      color 180ms ease,
      background 180ms ease;
  }

  .nav-link:hover {
    color: var(--text-primary);
  }

  .nav-link.is-active {
    color: var(--text-primary);
    background: var(--primary-surface);
  }

  :global(html.dark) .nav-link {
    color: color-mix(in srgb, var(--text-primary) 78%, transparent);
  }

  :global(html.dark) .nav-link:hover,
  :global(html.dark) .nav-link.is-active {
    color: var(--text-primary);
  }

  :global(html.dark) .nav-link.is-active {
    background: var(--primary-surface);
  }

  .nav-link.is-active::before {
    content: "";
    width: 6px;
    height: 6px;
    flex-shrink: 0;
    border-radius: 999px;
    background: var(--primary);
    box-shadow: 0 0 10px color-mix(in srgb, var(--primary) 70%, transparent);
  }

  :global(html.dark) .nav-link.is-active::before {
    box-shadow: 0 0 12px color-mix(in srgb, var(--primary) 85%, transparent);
  }

  .nav-utils {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 5px 10px 5px 12px;
    border-radius: 999px;
    background: var(--surface-quiet);
    border: 1px solid var(--border-subtle);
    flex-shrink: 0;
  }

  .nav-link.is-disabled,
  .nav-link:disabled {
    cursor: not-allowed;
    opacity: 0.45;
  }

  .nav-lang {
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .nav-lang__link {
    color: var(--text-muted);
    font-size: 12px;
    font-weight: 650;
    letter-spacing: 0.05em;
    line-height: 1;
    padding: 2px 3px;
    transition: color 180ms ease;
  }

  .nav-lang__link:hover,
  .nav-lang__link.is-active {
    color: var(--primary);
  }

  :global(html.dark) .nav-lang__link {
    color: var(--text-muted);
  }

  :global(html.dark) .nav-lang__link:hover,
  :global(html.dark) .nav-lang__link.is-active {
    color: var(--primary);
  }

  .nav-lang__slash {
    color: var(--text-muted);
    opacity: 0.45;
    font-size: 11px;
    font-weight: 500;
    line-height: 1;
    padding: 0 1px;
  }

  .nav-utils__divider {
    width: 1px;
    height: 14px;
    flex-shrink: 0;
    background: var(--border-subtle);
  }

  .nav-theme {
    display: grid;
    width: 28px;
    height: 28px;
    margin-right: -2px;
    place-items: center;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--primary);
    cursor: pointer;
  }

  :global(html.dark) .nav-theme {
    color: var(--primary);
  }

  .nav-theme:hover {
    background: var(--surface-quiet);
  }

  .nav-theme__icon {
    width: 16px;
    height: 16px;
    grid-area: 1 / 1;
    transition:
      opacity 200ms ease,
      transform 200ms ease;
  }

  .nav-theme__icon--moon {
    opacity: 0;
    transform: rotate(-45deg) scale(0.6);
  }

  :global(html.dark) .nav-theme__icon--sun {
    opacity: 0;
    transform: rotate(45deg) scale(0.6);
  }

  :global(html.dark) .nav-theme__icon--moon {
    opacity: 1;
    transform: none;
  }

  :global(.logo-wave) {
    position: fixed;
    z-index: 50;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    border: none;
    box-shadow: 0 0 20px color-mix(in srgb, var(--sky-atmo-bright) 28%, transparent);
    pointer-events: none;
    transform: translate(-50%, -50%) scale(1);
    animation: page-wave 900ms cubic-bezier(0.2, 0.75, 0.25, 1) forwards;
  }

  @keyframes logo-click-pulse {
    0% {
      opacity: 0.7;
      transform: scale(1);
    }
    100% {
      opacity: 0;
      transform: scale(2.25);
    }
  }

  @keyframes page-wave {
    0% {
      opacity: 0.55;
      transform: translate(-50%, -50%) scale(1);
    }
    100% {
      opacity: 0;
      transform: translate(-50%, -50%) scale(14);
    }
  }

  @media (max-width: 767px) {
    .site-nav-wrap {
      padding: 10px 12px 0;
    }

    .nav-toggle {
      display: grid;
    }

    .site-nav {
      flex-wrap: wrap;
      gap: 6px;
      padding: 4px 6px;
    }

    .cz-logo {
      width: 36px;
      height: 36px;
    }

    .nav-utils {
      order: 2;
      margin-left: auto;
      padding: 3px 6px;
      gap: 4px;
      background: transparent;
      border: none;
    }

    .nav-lang__link {
      font-size: 11px;
    }

    .nav-theme {
      width: 28px;
      height: 28px;
    }

    .nav-link--blog {
      display: none;
    }

    .nav-toggle {
      order: 3;
      width: 40px;
      height: 40px;
    }

    .site-nav__end {
      order: 4;
      position: absolute;
      top: calc(100% + 8px);
      right: 0;
      left: 0;
      z-index: 41;
      display: none;
      flex: none;
      flex-direction: column;
      align-items: stretch;
      gap: 2px;
      padding: 8px;
      border-radius: 20px;
      background: color-mix(in srgb, var(--canvas) 92%, white);
      border: 1px solid var(--glass-border);
      box-shadow:
        0 18px 40px rgba(15, 23, 42, 0.14),
        inset 0 1px 0 rgba(255, 255, 255, 0.55);
      backdrop-filter: blur(22px);
      -webkit-backdrop-filter: blur(22px);
    }

    :global(html.dark) .site-nav__end {
      background: color-mix(in srgb, var(--canvas) 88%, rgb(30 41 59));
      box-shadow:
        0 18px 40px rgba(0, 0, 0, 0.34),
        inset 0 1px 0 rgba(255, 255, 255, 0.05);
    }

    .site-nav.is-open .site-nav__end {
      display: flex;
    }

    .site-nav__links {
      flex-direction: column;
      align-items: stretch;
      gap: 2px;
      width: 100%;
    }

    .nav-link {
      justify-content: flex-start;
      min-height: 38px;
      padding: 0 12px;
      font-size: 14px;
      background: transparent;
      border: none;
    }

    .nav-link:hover {
      background: var(--surface-quiet);
    }

    .nav-link.is-active {
      background: var(--primary-surface);
    }

    .nav-link.is-active::before {
      width: 6px;
      height: 6px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-nav .cz-logo,
    .site-nav .nav-toggle,
    .site-nav .nav-link:not(.is-disabled):not(:disabled),
    .site-nav .nav-utils {
      opacity: 1;
      transform: none;
    }

    .site-nav .nav-link.is-disabled,
    .site-nav .nav-link:disabled {
      opacity: 0.45;
      transform: none;
    }
  }
</style>
