---
import { getLocaleFromPath, getLocalizedPath, getPathWithoutLocale, getTranslation } from "../utils/i18n";

const locales = ["en", "es"] as const;
const currentLocale = getLocaleFromPath(Astro.url.pathname);
const t = (key: string) => getTranslation(currentLocale, key);
const isServices = Astro.url.pathname.includes("/services");
const pathWithoutLocale = getPathWithoutLocale(Astro.url.pathname);
---

<div class="flex flex-wrap items-center justify-center gap-x-5 gap-y-3">
  <div
    data-language-switcher
    data-legacy-switcher
    class="relative inline-flex items-center bg-slate-100 dark:bg-slate-800 rounded-lg p-1 m-1 gap-1"
  >
    {
      locales.map((locale) => (
        <a
          href={getLocalizedPath(pathWithoutLocale, locale)}
          data-locale={locale}
          class={`relative px-3 py-1.5 text-sm font-medium rounded-md ${
            locale === currentLocale
              ? "text-[color:var(--primary)]"
              : "text-slate-500 hover:text-slate-700 dark:text-slate-400 dark:hover:text-slate-200"
          }`}
          aria-label={`Switch to ${locale === "en" ? "English" : "Español"}`}
          aria-current={locale === currentLocale ? "true" : "false"}
        >
          {locale === currentLocale && (
            <div
              data-locale-active-bg
              class="absolute inset-0 rounded-md shadow-sm bg-[color:var(--primary-surface)] ring-1 ring-[color:var(--primary-surface-strong)]"
            />
          )}
          <span class="relative z-10">{locale === "en" ? "EN" : "ES"}</span>
        </a>
      ))
    }
  </div>

  <!-- Theme Toggle -->
  <button
    id="theme-toggle"
    data-theme-toggle
    class="control-button bg-slate-100 dark:bg-slate-800"
    aria-label="Toggle theme"
    title="Toggle theme"
  >
    <!-- Sun icon for dark mode (when light theme is active) -->
    <svg
      id="sun-icon"
      class="h-5 w-5 text-[color:var(--primary)] transition-all duration-300 ease-in-out dark:rotate-90 dark:scale-0"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
      stroke-width="2"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
      ></path>
    </svg>

    <!-- Moon icon for light mode (when dark theme is active) -->
    <svg
      id="moon-icon"
      class="absolute h-5 w-5 text-[color:var(--primary)] transition-all duration-300 ease-in-out rotate-90 scale-0 dark:rotate-0 dark:scale-100"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
      stroke-width="2"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
    </svg>
  </button>
  {
    !isServices && (
      <button
        id="blog-button"
        class="control-button bg-slate-100 dark:bg-slate-800 !w-16 disabled:cursor-not-allowed disabled:pointer-events-none"
        aria-label="Blog"
        aria-disabled="true"
        disabled
        title="Coming soon"
      >
        <span class="text-sm">Blog</span>
      </button>
    )
  }
  {
    !isServices && (
      <a
        href={getLocalizedPath("/services", currentLocale)}
        data-localized-href="/services"
        data-i18n-aria="navigation.services"
        data-i18n-title="navigation.services"
        class="control-button relative bg-slate-100 dark:bg-slate-800 !w-auto px-3"
        aria-label={t("navigation.services")}
        title={t("navigation.services")}
      >
        <span class="text-sm" data-i18n="navigation.services">{t("navigation.services")}</span>
      </a>
    )
  }
</div>

<script>
  import { initLocaleSwitcher } from "../utils/apply-locale";
  import { initThemeToggle } from "../utils/theme";

  initLocaleSwitcher();
  initThemeToggle();

  // Handle birthday button click
  function initBirthdayButton() {
    const birthdayButton = document.getElementById("birthday-button");
    if (birthdayButton) {
      birthdayButton.addEventListener("click", () => {
        // Get current locale from URL
        const currentPath = window.location.pathname;
        const locale = currentPath.startsWith("/es") ? "es" : "en";

        // Store language preference in localStorage
        localStorage.setItem("preferred-language", locale);

        // Navigate to birthday page
        const birthdayPath = locale === "en" ? "/en/HB33" : "/es/HB33";
        window.location.href = birthdayPath;
      });
    }
  }

  // Initialize birthday button
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initBirthdayButton);
  } else {
    initBirthdayButton();
  }
</script>

<style>
  /* Common button styles */
  .control-button {
    @apply flex h-10 w-10 items-center justify-center rounded-lg shadow-sm transition-all duration-200 hover:scale-105 hover:shadow-md ring-1 ring-slate-200 dark:ring-slate-700 hover:bg-slate-200 dark:hover:bg-slate-700 disabled:bg-slate-200 dark:disabled:bg-slate-700 disabled:text-slate-500 dark:disabled:text-slate-400 disabled:ring-slate-300 dark:disabled:ring-slate-600 disabled:shadow-none;
  }

  .control-button:active {
    transform: scale(0.95);
  }

  /* Smooth icon transitions */
  #sun-icon,
  #moon-icon {
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
</style>
