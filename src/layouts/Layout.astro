---
interface Props {
  title?: string;
  description?: string;
  image?: string;
  url?: string;
  variant?: "default" | "hb";
  i18nPage?: "home" | "services" | "blog";
  ambientSubtle?: boolean;
  forceDark?: boolean;
}

const {
  title = "Carlos Zabaleta - Software Engineer | Toronto, Canada",
  description = "Carlos Zabaleta is a skilled Software Engineer based in Toronto, Canada...",
  image = "https://czab.dev/og-image.jpg",
  url = new URL(Astro.url.pathname, Astro.site).href,
  variant = "default",
  i18nPage,
  ambientSubtle,
  forceDark = false,
} = Astro.props;

import "@fontsource/inter";
import "@fontsource-variable/inter";
import "@fontsource-variable/manrope";
import "../styles/tokens.css";
import AmbientBackground from "../components/ambient-background.astro";
import SiteNav from "../components/site-nav.astro";
import ContactModal from "../components/contact-modal.astro";
import { getLocaleFromPath } from "../utils/i18n";

const locale = getLocaleFromPath(Astro.url.pathname);
const showChrome = variant === "default";
const useSubtleAmbient = ambientSubtle ?? (i18nPage === "services" || i18nPage === "blog");
const isMelodia = Astro.url.pathname.includes("/melodia");
const lockDark = forceDark || isMelodia;
---

<!doctype html>
<html lang={locale} prefix="og: http://ogp.me/ns#" class:list={[{ dark: lockDark }]} data-force-theme={lockDark ? "dark" : undefined}>
  <head>
    <!-- Critical inline styles to avoid flash on HB pages -->
    <style>
      body[data-page="hb"] {
        background: rgb(15 23 42);
      }
    </style>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />

    <!-- Primary Meta Tags (Dynamic) -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="Carlos Zabaleta, Software Engineer, Developer, Toronto, Canada, Full Stack Developer, JavaScript, React, Web Development, Frontend, Backend, Portfolio"
    />
    <meta name="author" content="Carlos Zabaleta" />
    <meta name="robots" content="index, follow" />
    <meta name="language" content={locale === "es" ? "Spanish" : "English"} />

    <!-- Open Graph / Facebook (Dynamic) -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:site_name" content="Carlos Zabaleta Portfolio" />
    <meta property="og:locale" content={locale === "es" ? "es_CA" : "en_CA"} />

    <!-- Twitter (Dynamic) -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={url} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />
    <meta property="twitter:creator" content="@czabalet" />

    <!-- Additional SEO Meta Tags -->
    <meta name="geo.region" content="CA-ON" />
    <meta name="geo.placename" content="Toronto" />
    <meta name="geo.position" content="43.6532;-79.3832" />
    <meta name="ICBM" content="43.6532, -79.3832" />

    <!-- Canonical URL (Dynamic) -->
    <link rel="canonical" href={url} />

    <!-- Favicon and Icons -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Generator -->
    <meta name="generator" content={Astro.generator} />

    <script is:inline>
      try {
        const forced = document.documentElement.getAttribute("data-force-theme");
        if (forced === "dark") {
          document.documentElement.classList.add("dark");
        } else {
          const theme = localStorage.getItem("theme");
          // Brand default is dark; only honor an explicit user choice.
          document.documentElement.classList.toggle("dark", theme !== "light");
        }
      } catch {
        document.documentElement.classList.add("dark");
      }

      // Hide [data-reveal] content before first paint so scroll reveals never flash.
      // Page scripts are deferred modules that run before DOMContentLoaded; one that
      // animates reveals adds `reveal-ready`. If none did, show everything as is.
      if (!matchMedia("(prefers-reduced-motion: reduce)").matches && "IntersectionObserver" in window) {
        const root = document.documentElement;
        root.classList.add("reveal-armed");
        document.addEventListener("DOMContentLoaded", () => {
          if (!root.classList.contains("reveal-ready")) root.classList.remove("reveal-armed");
        });
      }
    </script>

    <!-- Structured Data -->
    <script is:inline type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Carlos Zabaleta",
        "jobTitle": "Software Engineer",
        "email": "mailto:hello@czab.dev",
        "description": "Skilled Software Engineer specializing in full-stack development and modern web technologies",
        "url": "https://czab.dev",
        "image": "https://czab.dev/favicon.ico",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Toronto",
          "addressRegion": "Ontario",
          "addressCountry": "Canada"
        },
        "sameAs": [
          "https://github.com/c-zab",
          "https://www.linkedin.com/in/czabalet/",
          "https://codepen.io/c-zab",
          "https://www.instagram.com/czabalet.dev/"
        ],
        "knowsAbout": [
          "JavaScript",
          "TypeScript",
          "React",
          "Node.js",
          "Full Stack Development",
          "Web Development",
          "Software Engineering",
          "Frontend Development",
          "Backend Development"
        ],
        "alumniOf": {
          "@type": "Organization",
          "name": "Software Engineering"
        },
        "workLocation": {
          "@type": "Place",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Toronto",
            "addressRegion": "Ontario",
            "addressCountry": "Canada"
          }
        }
      }
    </script>
    <noscript><style>.typed__text, .title-rotator__phrase.is-active { opacity: 1 !important; transform: none !important; filter: none !important; }</style></noscript>
  </head>
  <body
    data-page={variant}
    data-i18n-page={i18nPage}
    class="leading-relaxed antialiased selection:bg-[color:var(--primary-surface-strong)] selection:text-[color:var(--primary)]"
    style="color: var(--text-secondary);"
  >
    {showChrome && <AmbientBackground subtle={useSubtleAmbient} />}
    {showChrome && <SiteNav lockDark={lockDark} />}
    <div class="inset-0 z-30">
      <slot />
    </div>
    {showChrome && <ContactModal />}

    <script>
      const isHBPage = document.body && document.body.dataset.page === "hb";
      if (isHBPage) {
        document.documentElement.style.opacity = "1";
      }
    </script>
  </body>

  <style is:global>
    :root {
      font-family: InterVariable, sans-serif;
      font-feature-settings:
        "liga" 1,
        "ss03",
        "cv02",
        "cv11",
        "calt" 1;
    }
    @supports (font-variation-settings: normal) {
      :root {
        font-family: InterVariable, sans-serif;
      }
    }
    html {
      transition: background-color 0.3s ease;
    }

    html {
      background: var(--canvas);
    }

    html.reveal-armed [data-reveal-item]:not(.is-revealed),
    html.reveal-armed [data-reveal]:not(:has([data-reveal-item])):not(.is-revealed) {
      opacity: 0;
    }

    /* Cross-page transitions on normal link clicks (Chrome, Edge, Safari 18.2+).
       The nav keeps its own name so it stays put while the page underneath fades. */
    @view-transition {
      navigation: auto;
    }

    /* Only retime the browser's own crossfade. Its animations also blend the two pages
       with plus-lighter so they always add up to full opacity; replacing them with
       custom keyframes drops that blend and the page dims halfway, which reads as a flash. */
    ::view-transition-group(*) {
      animation-duration: 280ms;
      animation-timing-function: cubic-bezier(0.2, 0.75, 0.3, 1);
    }

    @media (prefers-reduced-motion: reduce) {
      @view-transition {
        navigation: none;
      }
    }

    html.hero-ready .hero-enter {
      opacity: 1 !important;
      transform: none !important;
    }

    body.nav-locked {
      overflow: hidden;
    }
  </style>
</html>
