---
import Layout from "../layouts/Layout.astro";
import Icon from "./icon.astro";
import CaseStudyExample from "./case-study-example.astro";
import { type IconName } from "../utils/icons";
import { getLocaleFromPath, getTranslation, getTranslationList } from "../utils/i18n";
import { accentize } from "../utils/accent-text";
import { CONTACT_EMAIL } from "../utils/site";

const locale = getLocaleFromPath(Astro.url.pathname);
const t = (key: string) => getTranslation(locale, key);

const packageConfig = {
  discovery: {
    chips: [
      { icon: "clock" as const, key: "hours" },
      { icon: "video" as const, key: "format" },
    ],
    detailIcons: ["lightbulb", "users", "rocket"] as const,
  },
  launch: {
    chips: [
      { icon: "clipboard" as const, key: "scope" },
      { icon: "refresh" as const, key: "revisions" },
    ],
    detailIcons: ["clipboard", "globe", "layout", "cart", "plug"] as const,
  },
  retain: {
    chips: [{ icon: "clock" as const, key: "hours" }],
    detailIcons: ["check", "wrench", "server", "users", "rocket"] as const,
  },
} satisfies Record<
  string,
  { chips: { icon: IconName; key: string }[]; detailIcons: readonly IconName[] }
>;

const packageIds = ["discovery", "launch", "retain"] as const;
const featuredPackage = "launch";
const helpIds = ["websites", "internal", "ideas", "integrations", "automations", "maintenance"] as const;
const helpIcons: Record<(typeof helpIds)[number], IconName> = {
  websites: "globe",
  internal: "layout",
  ideas: "lightbulb",
  integrations: "plug",
  automations: "zap",
  maintenance: "wrench",
};
const processIds = ["discovery", "planning", "sprints", "delivery"] as const;
const processIcons: Record<(typeof processIds)[number], IconName> = {
  discovery: "search",
  planning: "clipboard",
  sprints: "refresh",
  delivery: "rocket",
};
const whyIcons: IconName[] = ["target", "code", "zap"];
const heroBenefitIcons: IconName[] = ["message", "users", "code"];

const packages = packageIds.map((id) => {
  const config = packageConfig[id];
  const details = getTranslationList(locale, `services.packages.${id}.details`);

  return {
    id,
    featured: id === featuredPackage,
    name: t(`services.packages.${id}.name`),
    timing: t(`services.packages.${id}.timing`),
    lead: t(`services.packages.${id}.lead`),
    cta: t(`services.packages.${id}.cta`),
    includesTitle: t(`services.packages.${id}.includesTitle`),
    chips: config.chips.map((chip: { icon: IconName; key: string }) => ({
      ...chip,
      label: t(`services.packages.${id}.chips.${chip.key}`),
    })),
    details: details.map((label, index) => ({
      label,
      icon: (config.detailIcons[index] ?? "check") as IconName,
    })),
  };
});

const helpItems = helpIds.map((id) => ({
  id,
  icon: helpIcons[id],
  label: t(`services.help.items.${id}.label`),
  title: t(`services.help.items.${id}.title`),
  body: t(`services.help.items.${id}.body`),
}));

const processSteps = processIds.map((id, index) => ({
  id,
  number: String(index + 1).padStart(2, "0"),
  icon: processIcons[id],
  title: t(`services.process.steps.${id}.title`),
  body: t(`services.process.steps.${id}.body`),
}));

const titleEndings = getTranslationList(locale, "services.titleEndings");

const heroBenefits = getTranslationList(locale, "services.heroBenefits").map((label, index) => ({
  label,
  index,
  icon: heroBenefitIcons[index] ?? "check",
}));

const faqIds = ["cost", "timeline", "after", "language"] as const;
const faqItems = faqIds.map((id) => ({
  id,
  q: t(`services.faq.items.${id}.q`),
  a: t(`services.faq.items.${id}.a`),
}));

const whyPoints = getTranslationList(locale, "services.why.points").map((label, index) => ({
  label,
  icon: whyIcons[index] ?? "check",
}));

const helpTools = getTranslationList(locale, "services.help.tools");
// Repeat the list so one marquee group is always wider than the viewport.
const marqueeTools = [...helpTools, ...helpTools].map((label, index) => ({
  label,
  key: `services.help.tools.${index % helpTools.length}`,
  repeat: index >= helpTools.length,
}));
const profilePhoto = "/images/carlos.jpg";
---

<Layout
  title={t("services.seoTitle")}
  description={t("services.seoDescription")}
  i18nPage="services"
>
  <div class="relative z-10 mx-auto min-h-dvh max-w-screen-xl px-5 pb-12 pt-24 font-sans sm:px-6 sm:pt-28 md:px-12 lg:px-16 xl:px-20">
    <main role="main">
      <header
        class="services-hero grid content-center items-center justify-items-center gap-10 pt-4 text-center sm:min-h-[calc(100svh-7rem)] lg:min-h-[64vh] lg:grid-cols-[minmax(0,1.4fr)_minmax(0,1fr)] lg:justify-items-stretch lg:gap-16 lg:pt-0 lg:text-left"
        data-reveal
      >
        <div class="services-hero__intro max-w-2xl">
        <h1
          class="services-hero__title text-[clamp(1.75rem,8vw,2.25rem)] leading-[1.15] font-bold tracking-tight sm:text-5xl lg:text-[3.35rem] lg:leading-[1.08]"
          style="color: var(--text-primary);"
          aria-label={t("services.title")}
          data-i18n-aria="services.title"
        >
          <span class="typed" data-services-title>
            <span class="typed__text" aria-hidden="true" data-i18n="services.titleLead">{t("services.titleLead")}</span>
          </span>
          {/* Every ending sits in the same grid cell, so the widest one reserves the space
              and the layout never shifts as they rotate. */}
          <span class="title-rotator" aria-hidden="true" data-title-rotator>
            {titleEndings.map((ending, index) => (
              <span
                class:list={["title-rotator__phrase", { "is-active": index === 0 }]}
                data-i18n={`services.titleEndings.${index}`}
              >
                {ending}
              </span>
            ))}
          </span>
        </h1>
        <p
          class="services-hero__tagline mx-auto mt-6 max-w-2xl text-lg leading-snug sm:text-xl lg:mx-0 lg:text-[1.4rem] lg:leading-snug"
          style="color: var(--text-secondary);"
          data-reveal-item
          data-i18n-accent="services.tagline"
          set:html={accentize(t("services.tagline"))}
        />
        <div class="hero-actions mt-10 flex flex-wrap items-center justify-center gap-3 lg:mt-9 lg:justify-start" data-reveal-item>
          <button type="button" data-contact-open="discovery" class="btn-cta" data-i18n="services.heroPrimary">
            {t("services.heroPrimary")}
          </button>
          <a href="#packages" class="btn-ghost" data-scroll-to="packages">
            <span data-i18n="services.heroSecondary">{t("services.heroSecondary")}</span>
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="btn-ghost__arrow h-4 w-4"
              aria-hidden="true"
            >
              <path d="M12 5v14M19 12l-7 7-7-7"></path>
            </svg>
          </a>
        </div>
        <ul class="hero-benefits" data-reveal-item>
          {heroBenefits.map((benefit) => (
            <li>
              <Icon name={benefit.icon} class="h-4 w-4" />
              <span data-i18n={`services.heroBenefits.${benefit.index}`}>{benefit.label}</span>
            </li>
          ))}
        </ul>
        </div>

        <aside class="company-card" data-reveal-item aria-labelledby="company-card-name">
          <div class="flex items-center gap-4">
            <span class="company-card__mark" aria-hidden="true">CZ</span>
            <div>
              <p id="company-card-name" class="company-card__name" data-i18n="services.company.name">
                {t("services.company.name")}
              </p>
              <p class="company-card__sub" data-i18n="services.company.incorporated">
                {t("services.company.incorporated")}
              </p>
            </div>
          </div>
          <ul class="company-card__facts">
            <li>
              <Icon name="mapPin" class="h-5 w-5" />
              <span data-i18n="services.company.location">{t("services.company.location")}</span>
            </li>
            <li>
              <Icon name="languages" class="h-5 w-5" />
              <span data-i18n="services.company.languages">{t("services.company.languages")}</span>
            </li>
            <li>
              <Icon name="video" class="h-5 w-5" />
              <span data-i18n="services.company.firstCall">{t("services.company.firstCall")}</span>
            </li>
          </ul>
          <p class="company-card__founder" data-i18n="services.company.founder">{t("services.company.founder")}</p>
        </aside>
      </header>

      <section class="mt-16 lg:mt-20" aria-labelledby="services-help" data-reveal>
        <h2
          id="services-help"
          class="text-xl font-semibold tracking-tight"
          style="color: var(--text-primary);"
          data-reveal-item
          data-i18n="services.help.title"
        >
          {t("services.help.title")}
        </h2>
        <p
          class="mt-3 max-w-3xl text-sm leading-relaxed lg:text-base"
          style="color: var(--text-secondary);"
          data-reveal-item
          data-i18n="services.help.lead"
        >
          {t("services.help.lead")}
        </p>

        <ul class="sr-only" data-i18n-list="services.help.tools">
          {helpTools.map((tool) => <li>{tool}</li>)}
        </ul>
        <div class="tool-marquee mt-5" aria-hidden="true" data-reveal-item>
          <div class="tool-marquee__track">
            {
              [0, 1].map((group) => (
                <ul class:list={["tool-marquee__group", { "tool-marquee__clone": group === 1 }]}>
                  {marqueeTools.map((tool) => (
                    <li class:list={["badge-tool", { "tool-marquee__repeat": tool.repeat }]} data-i18n={tool.key}>
                      {tool.label}
                    </li>
                  ))}
                </ul>
              ))
            }
          </div>
        </div>

        <ul class="build-grid mt-8 grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
          {
            helpItems.map((item) => (
              <li data-reveal-item>
                <button type="button" class="build-card" aria-expanded="false" data-build-card>
                  <span class="build-card__icon">
                    <Icon name={item.icon} class="h-5 w-5" />
                  </span>
                  <span class="build-card__text">
                    <span class="build-card__label" data-i18n={`services.help.items.${item.id}.label`}>
                      {item.label}
                    </span>
                    <span class="build-card__title" data-i18n={`services.help.items.${item.id}.title`}>
                      {item.title}
                    </span>
                    <span class="build-card__body">
                      <span data-i18n={`services.help.items.${item.id}.body`}>{item.body}</span>
                    </span>
                  </span>
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    class="build-card__plus"
                    aria-hidden="true"
                  >
                    <path d="M12 5v14M5 12h14"></path>
                  </svg>
                </button>
              </li>
            ))
          }
        </ul>
      </section>

      {import.meta.env.DEV && <CaseStudyExample />}

      <section id="packages" class="packages-section mt-20" aria-labelledby="services-packages" data-reveal>
        <h2
          id="services-packages"
          class="text-xl font-semibold tracking-tight"
          style="color: var(--text-primary);"
          data-reveal-item
          data-i18n="services.packagesTitle"
        >
          {t("services.packagesTitle")}
        </h2>
        <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {
            packages.map((pkg) => (
              <li data-reveal-item class="h-full">
                <article class:list={["package-card", { "is-featured": pkg.featured }]}>
                  {pkg.featured && (
                    <span class="package-card__badge" data-i18n="services.featured">
                      {t("services.featured")}
                    </span>
                  )}
                  <div class="flex items-start justify-between gap-3">
                    <h3
                      class="text-xl font-semibold tracking-tight"
                      style="color: var(--text-primary);"
                      data-i18n={`services.packages.${pkg.id}.name`}
                    >
                      {pkg.name}
                    </h3>
                    <p
                      class="badge-signal shrink-0 rounded-full px-2.5 py-0.5 text-xs font-medium"
                      data-i18n={`services.packages.${pkg.id}.timing`}
                    >
                      {pkg.timing}
                    </p>
                  </div>
                  <ul class="mt-3 flex flex-wrap gap-2">
                    {pkg.chips.map((chip) => (
                      <li
                        class="surface-quiet inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs"
                        style="color: var(--text-secondary);"
                      >
                        <span style="color: var(--text-muted);">
                          <Icon name={chip.icon} class="h-4 w-4" />
                        </span>
                        <span data-i18n={`services.packages.${pkg.id}.chips.${chip.key}`}>{chip.label}</span>
                      </li>
                    ))}
                  </ul>
                  <p
                    class="mt-4 text-sm leading-relaxed"
                    style="color: var(--text-secondary);"
                    data-i18n={`services.packages.${pkg.id}.lead`}
                  >
                    {pkg.lead}
                  </p>

                  <button
                    type="button"
                    class="includes-toggle mt-5"
                    aria-expanded="false"
                    aria-controls={`includes-${pkg.id}`}
                    data-includes-toggle
                  >
                    <span data-i18n={`services.packages.${pkg.id}.includesTitle`}>{pkg.includesTitle}</span>
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="includes-toggle__chevron"
                      aria-hidden="true"
                    >
                      <path d="m6 9 6 6 6-6"></path>
                    </svg>
                  </button>
                  <div class="includes" id={`includes-${pkg.id}`}>
                    <div class="includes__inner">
                      <ul class="space-y-2.5 pt-3">
                        {pkg.details.map((item, index) => (
                          <li class="flex items-center gap-3 text-sm" style="color: var(--text-secondary);">
                            <span class="icon-tile flex h-8 w-8 shrink-0 items-center justify-center rounded-lg">
                              <Icon name={item.icon} class="h-5 w-5" />
                            </span>
                            <span data-i18n={`services.packages.${pkg.id}.details.${index}`}>{item.label}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  </div>

                  <div class="mt-auto pt-6">
                    <button
                      type="button"
                      data-contact-open={pkg.id}
                      class="btn-cta w-full"
                      data-i18n={`services.packages.${pkg.id}.cta`}
                    >
                      {pkg.cta}
                    </button>
                  </div>
                </article>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="mt-20" aria-labelledby="services-process" data-reveal>
        <h2
          id="services-process"
          class="text-xl font-semibold tracking-tight"
          style="color: var(--text-primary);"
          data-reveal-item
          data-i18n="services.process.title"
        >
          {t("services.process.title")}
        </h2>
        <p
          class="mt-3 max-w-3xl text-sm leading-relaxed lg:text-base"
          style="color: var(--text-muted);"
          data-reveal-item
          data-i18n="services.process.lead"
        >
          {t("services.process.lead")}
        </p>
        <ol class="process mt-10" data-process>
          {
            processSteps.map((step) => (
              <li class="process-step" data-reveal-item>
                <span class="process-step__dot">
                  <Icon name={step.icon} class="h-5 w-5" />
                </span>
                <div>
                  <p class="process-step__num">{step.number}</p>
                  <h3
                    class="mt-1 text-sm font-semibold"
                    style="color: var(--text-primary);"
                    data-i18n={`services.process.steps.${step.id}.title`}
                  >
                    {step.title}
                  </h3>
                  <p
                    class="mt-1 text-sm leading-relaxed"
                    style="color: var(--text-secondary);"
                    data-i18n={`services.process.steps.${step.id}.body`}
                  >
                    {step.body}
                  </p>
                </div>
              </li>
            ))
          }
        </ol>
        <p
          class="mt-10 max-w-3xl text-sm leading-relaxed lg:text-base"
          style="color: var(--text-muted);"
          data-reveal-item
          data-i18n="services.process.outro"
        >
          {t("services.process.outro")}
        </p>
      </section>

      <section class="mx-auto mt-20 max-w-3xl" aria-labelledby="services-faq" data-reveal>
        <h2
          id="services-faq"
          class="text-xl font-semibold tracking-tight"
          style="color: var(--text-primary);"
          data-reveal-item
          data-i18n="services.faq.title"
        >
          {t("services.faq.title")}
        </h2>
        <div class="faq mt-6">
          {
            faqItems.map((item) => (
              <details class="faq__item" data-reveal-item>
                <summary class="faq__question">
                  <span data-i18n={`services.faq.items.${item.id}.q`}>{item.q}</span>
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    class="faq__icon"
                    aria-hidden="true"
                  >
                    <path d="M12 5v14M5 12h14"></path>
                  </svg>
                </summary>
                <p class="faq__answer" data-i18n={`services.faq.items.${item.id}.a`}>
                  {item.a}
                </p>
              </details>
            ))
          }
        </div>
      </section>

      <section class="why-section mx-auto mt-20 max-w-4xl pb-8 text-center" aria-labelledby="services-why" data-reveal>
        <h2
          id="services-why"
          class="text-xl font-semibold tracking-tight"
          style="color: var(--text-primary);"
          data-reveal-item
          data-i18n="services.why.title"
        >
          {t("services.why.title")}
        </h2>
        <p
          class="mx-auto mt-3 max-w-2xl text-sm leading-relaxed"
          style="color: var(--text-secondary);"
          data-reveal-item
          data-i18n="services.why.lead"
        >
          {t("services.why.lead")}
        </p>

        <div class="why-panel surface-interactive mx-auto mt-8 overflow-hidden rounded-2xl text-left" data-reveal-item>
          <div class="grid md:grid-cols-[minmax(180px,220px)_1fr]">
            <div class="why-photo" data-profile-photo-wrap>
              <img
                src={profilePhoto}
                alt={t("services.why.photoAlt")}
                class="why-photo__img hidden"
                data-profile-photo
                loading="lazy"
                decoding="async"
              />
              <div class="why-photo__placeholder" data-profile-fallback>
                <span class="why-photo__initials" aria-hidden="true">CZ</span>
              </div>
            </div>

            <ul class="why-table divide-y" style="border-color: var(--border-subtle);">
              {
                whyPoints.map((point, index) => (
                  <li
                    class="why-table__row flex items-start gap-3 px-5 py-4 text-sm leading-relaxed"
                    style="color: var(--text-secondary);"
                  >
                    <span class="why-table__icon icon-tile mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg">
                      <Icon name={point.icon} class="h-5 w-5" />
                    </span>
                    <span data-i18n={`services.why.points.${index}`}>{point.label}</span>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>

        <p class="mt-10 text-base font-medium" style="color: var(--text-primary);" data-reveal-item data-i18n="services.why.cta">
          {t("services.why.cta")}
        </p>
        <p class="mt-1 text-sm leading-relaxed" style="color: var(--text-muted);" data-reveal-item data-i18n="services.why.ctaSub">
          {t("services.why.ctaSub")}
        </p>
        <div data-reveal-item>
          <button type="button" data-contact-open class="btn-cta mt-6" data-i18n="services.cta">
            {t("services.cta")}
          </button>
        </div>
        <p class="mt-4 text-sm" style="color: var(--text-muted);" data-reveal-item>
          <span data-i18n="services.why.emailAlt">{t("services.why.emailAlt")}</span>{" "}
          <a href={`mailto:${CONTACT_EMAIL}`} class="email-link">{CONTACT_EMAIL}</a>
        </p>
      </section>
    </main>
  </div>
</Layout>

<script>
  import { getTranslation, type Locale } from "../utils/i18n";
  import { createTypewriter } from "../utils/typewriter";

  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // "One developer," types itself out like the name on the home page. Then the ending
  // fades in and rotates between a few benefits. A language switch retypes the lead
  // and starts the endings over in the new language.
  const heroHeading = document.querySelector<HTMLElement>(".services-hero__title");
  const heroTitle = document.querySelector<HTMLElement>("[data-services-title]");
  const rotator = document.querySelector<HTMLElement>("[data-title-rotator]");

  if (heroHeading && heroTitle && rotator) {
    const phrases = Array.from(rotator.querySelectorAll<HTMLElement>(".title-rotator__phrase"));
    const typewriter = createTypewriter(heroTitle, { startDelay: 450 });
    const ROTATE_MS = 3500;
    let current = 0;
    let timer = 0;
    // Bumped on every language switch so a stale retype doesn't show the ending.
    let generation = 0;

    const showPhrase = (next: number) => {
      phrases.forEach((phrase, index) => {
        phrase.classList.toggle("is-active", index === next);
        phrase.classList.toggle("is-leaving", index === current && index !== next);
      });
      current = next;
    };

    const stopRotation = () => {
      window.clearInterval(timer);
      timer = 0;
    };

    const startRotation = () => {
      stopRotation();
      if (prefersReducedMotion || phrases.length < 2 || document.hidden) return;
      timer = window.setInterval(() => showPhrase((current + 1) % phrases.length), ROTATE_MS);
    };

    const revealEnding = () => {
      showPhrase(0);
      heroHeading.classList.add("is-complete");
      startRotation();
    };

    typewriter.done.then(revealEnding);

    document.addEventListener("visibilitychange", () => {
      if (document.hidden) stopRotation();
      else if (heroHeading.classList.contains("is-complete")) startRotation();
    });

    document.addEventListener("localechange", (event) => {
      const { locale } = (event as CustomEvent<{ locale: Locale }>).detail;
      const id = ++generation;
      stopRotation();
      heroHeading.classList.remove("is-complete");
      typewriter.retype(getTranslation(locale, "services.titleLead")).then(() => {
        if (id === generation) revealEnding();
      });
    });
  }

  // Profile photo falls back to initials until a real photo exists.
  const photo = document.querySelector<HTMLImageElement>("[data-profile-photo]");
  const fallback = document.querySelector<HTMLElement>("[data-profile-fallback]");

  if (photo && fallback) {
    photo.addEventListener("load", () => {
      photo.classList.remove("hidden");
      fallback.classList.add("hidden");
    });
    photo.addEventListener("error", () => {
      photo.classList.add("hidden");
      fallback.classList.remove("hidden");
    });

    if (photo.complete && photo.naturalWidth > 0) {
      photo.classList.remove("hidden");
      fallback.classList.add("hidden");
    }
  }

  // Expandable "what I build" cards: hover previews on desktop, click toggles. Touch
  // screens show every description up front (see CSS), so there is nothing to toggle.
  const canHover = window.matchMedia("(hover: hover)").matches;
  document.querySelectorAll<HTMLButtonElement>("[data-build-card]").forEach((card) => {
    if (!canHover) {
      card.removeAttribute("aria-expanded");
      return;
    }
    card.addEventListener("click", () => {
      const open = !card.classList.contains("is-open");
      card.classList.toggle("is-open", open);
      card.setAttribute("aria-expanded", open ? "true" : "false");
    });
  });

  // Package "what's included" toggles.
  document.querySelectorAll<HTMLButtonElement>("[data-includes-toggle]").forEach((toggle) => {
    const panel = document.getElementById(toggle.getAttribute("aria-controls") ?? "");
    toggle.addEventListener("click", () => {
      const open = toggle.getAttribute("aria-expanded") !== "true";
      toggle.setAttribute("aria-expanded", open ? "true" : "false");
      panel?.classList.toggle("is-open", open);
    });
  });

  // "See packages" scrolls smoothly instead of jumping.
  document.querySelectorAll<HTMLAnchorElement>("[data-scroll-to]").forEach((link) => {
    link.addEventListener("click", (event) => {
      const target = document.getElementById(link.dataset.scrollTo ?? "");
      if (!target) return;
      event.preventDefault();
      target.scrollIntoView({ behavior: prefersReducedMotion ? "auto" : "smooth", block: "start" });
    });
  });

  // Items fade up as they enter the viewport. The Layout head script arms
  // `html.reveal-armed` before first paint so nothing flashes in and then hides;
  // if this script loaded too late the Layout disarms it and the page just shows.
  const root = document.documentElement;
  const process = document.querySelector<HTMLElement>("[data-process]");

  if (root.classList.contains("reveal-armed")) {
    root.classList.add("reveal-ready");

    const settle = (el: HTMLElement) => {
      el.classList.add("is-revealed");
      if (process?.contains(el)) process.classList.add("is-line-drawn");
    };

    // Each item is watched on its own, so items low in a tall section (stacked
    // package cards on a phone) still animate when they are actually seen.
    const observer = new IntersectionObserver(
      (entries) => {
        let index = 0;
        entries.forEach((entry) => {
          const el = entry.target as HTMLElement;
          if (entry.isIntersecting) {
            observer.unobserve(el);
            settle(el);
            el.animate(
              [
                { opacity: 0, translate: "0 18px" },
                { opacity: 1, translate: "0 0" },
              ],
              {
                duration: 620,
                delay: Math.min(index++, 8) * 70,
                easing: "cubic-bezier(0.2, 0.75, 0.3, 1)",
                fill: "backwards",
              }
            );
          } else if (entry.boundingClientRect.bottom < 0) {
            // Already scrolled past (restored scroll position): show it without a replay.
            observer.unobserve(el);
            settle(el);
          }
        });
      },
      { rootMargin: "0px 0px -8% 0px", threshold: 0 }
    );

    document.querySelectorAll<HTMLElement>("[data-reveal]").forEach((section) => {
      const items = Array.from(section.querySelectorAll<HTMLElement>("[data-reveal-item]"));
      (items.length ? items : [section]).forEach((el) => observer.observe(el));
    });
  }
</script>

