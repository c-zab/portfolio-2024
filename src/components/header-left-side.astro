---
import Navbar from "../components/navbar.astro";
import { getLocaleFromPath, getTranslation } from "../utils/i18n";
import { accentize } from "../utils/accent-text";

const locale = getLocaleFromPath(Astro.url.pathname);
const t = (key: string) => getTranslation(locale, key);
---

<header class="flex w-full max-w-full flex-col items-center px-1">
  <div class="flex w-full max-w-full flex-col items-center">
    <h1
      class="ml11 text-[clamp(1.7rem,7.2vw,3rem)] font-bold tracking-tight"
      style="color: var(--text-primary);"
      aria-label={t("common.name")}
    >
      <span class="text-wrapper" aria-hidden="true">
        <span class="line line1"></span>
        <span class="letters">{t("common.name")}</span>
      </span>
    </h1>
    <h2
      data-hero-title
      data-i18n="common.title"
      class="hero-enter mt-3 text-lg font-medium tracking-tight sm:text-xl"
      style="color: var(--text-primary);"
    >
      {t("common.title")}
    </h2>
    <p
      data-hero-bio
      data-i18n-accent="header.description"
      class="hero-enter mt-4 max-w-lg leading-normal"
      style="color: var(--text-secondary);"
      set:html={accentize(t("header.description"))}
    />
    <div data-hero-chrome class="hero-enter mt-8">
      <Navbar />
    </div>
  </div>
</header>

<script>
  import anime from "animejs";

  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const textWrapper = document.querySelector(".ml11 .letters");
  const enterEls = document.querySelectorAll<HTMLElement>(".hero-enter");

  // #region agent log
  const __dbg = (hypothesisId: string, message: string, data: Record<string, unknown> = {}) => {
    fetch("http://127.0.0.1:7492/ingest/89ec010a-f3d9-4ec5-962c-ad0cd94b6d45", {
      method: "POST",
      headers: { "Content-Type": "application/json", "X-Debug-Session-Id": "3bc5bd" },
      body: JSON.stringify({
        sessionId: "3bc5bd",
        runId: "post-fix",
        hypothesisId,
        location: "header-left-side.astro",
        message,
        data,
        timestamp: Date.now(),
      }),
    }).catch(() => {});
  };
  const __snap = () => {
    const letter = document.querySelector<HTMLElement>(".ml11 .letter");
    const letters = document.querySelector<HTMLElement>(".ml11 .letters");
    const title = document.querySelector<HTMLElement>("[data-hero-title]");
    return {
      heroReady: document.documentElement.classList.contains("hero-ready"),
      isSplit: letters?.classList.contains("is-split") ?? false,
      letterCount: document.querySelectorAll(".ml11 .letter").length,
      lettersOpacity: letters ? getComputedStyle(letters).opacity : null,
      lettersInline: letters?.style.opacity || "",
      letterOpacity: letter ? getComputedStyle(letter).opacity : null,
      letterInline: letter?.style.opacity || "",
      titleOpacity: title ? getComputedStyle(title).opacity : null,
      titleInline: title?.style.opacity || "",
      themeDark: document.documentElement.classList.contains("dark"),
      reducedMotion,
      visibility: document.visibilityState,
    };
  };
  __dbg("A", "hero script start", __snap());
  // #endregion

  function showHeroSettled() {
    enterEls.forEach((el) => {
      el.style.opacity = "1";
      el.style.transform = "none";
    });
    document.querySelectorAll<HTMLElement>(".ml11 .letter").forEach((el) => {
      el.style.opacity = "1";
    });
    textWrapper?.classList.add("is-split");
    document.documentElement.classList.add("hero-ready");
    // #region agent log
    __dbg("A", "showHeroSettled called", __snap());
    // #endregion
  }

  if (reducedMotion) {
    // #region agent log
    __dbg("A", "branch reducedMotion", {});
    // #endregion
    showHeroSettled();
  } else {
    enterEls.forEach((el) => {
      el.style.opacity = "0";
    });

    if (textWrapper) {
      textWrapper.innerHTML = (textWrapper.textContent ?? "")
        .split(/(\s+)/)
        .map((token) => {
          if (/^\s+$/.test(token)) return " ";
          return `<span class="word">${token.replace(/([^\x00-\x80]|\w)/g, "<span class='letter'>$&</span>")}</span>`;
        })
        .join("");

      // Reveal the name container only after letters exist (CSS keeps raw text hidden pre-JS).
      textWrapper.classList.add("is-split");
      // #region agent log
      __dbg("C", "letters split done", __snap());
      // #endregion

      // Anime can stall (hidden tab, competing tweens). Match SiteNav: always reveal.
      const heroFallback = window.setTimeout(() => {
        // #region agent log
        __dbg("A", "hero fallback settle", __snap());
        // #endregion
        showHeroSettled();
      }, 2800);

      const startLinePulse = () => {
        anime({
          targets: ".ml11 .line",
          opacity: [0, 1],
          easing: "linear",
          loop: true,
          duration: 1000,
        });
      };

      anime
        .timeline({
          easing: "easeOutExpo",
          duration: 500,
          complete: () => {
            window.clearTimeout(heroFallback);
            showHeroSettled();
            startLinePulse();
            // #region agent log
            __dbg("A", "timeline complete → hero-ready", __snap());
            // #endregion
          },
        })
        .add({
          targets: ".ml11 .line",
          scaleY: [0, 1],
          opacity: [0.5, 1],
          delay: 180,
        })
        .add({
          targets: ".ml11 .line",
          translateX: [0, textWrapper.getBoundingClientRect().width + 10],
          duration: 1000,
        })
        .add(
          {
            targets: ".ml11 .letter",
            opacity: [0, 1],
            duration: 600,
            offset: "-=775",
            delay: (_el: unknown, i: number) => 40 * (i + 1),
          },
          "-=900"
        )
        .add(
          {
            targets: "[data-hero-title]",
            opacity: [0, 1],
            translateY: [12, 0],
            duration: 400,
          },
          "-=200"
        )
        .add(
          {
            targets: "[data-hero-bio]",
            opacity: [0, 1],
            translateY: [12, 0],
            duration: 400,
          },
          "-=200"
        )
        .add(
          {
            targets: "[data-hero-chrome]",
            opacity: [0, 1],
            duration: 400,
          },
          "-=150"
        )
        .add(
          {
            targets: "[data-tech-marquee]",
            opacity: [0, 1],
            duration: 500,
          },
          "-=100"
        );
      // #region agent log
      __dbg("E", "timeline started; line loop deferred until complete/fallback", {
        lineCount: document.querySelectorAll(".ml11 .line").length,
      });
      window.setTimeout(() => __dbg("A", "t+2s snapshot", __snap()), 2000);
      window.setTimeout(() => __dbg("B", "t+4s snapshot", __snap()), 4000);
      // #endregion
    } else {
      // #region agent log
      __dbg("C", "no textWrapper — settle immediately", {});
      // #endregion
      showHeroSettled();
    }
  }
</script>

<style>
  .ml11 .text-wrapper {
    position: relative;
    display: inline-block;
    max-width: 100%;
    padding-top: 0.1em;
    padding-right: 0.05em;
    padding-bottom: 0.15em;
  }

  .ml11 :global(.word) {
    display: inline-block;
    white-space: nowrap;
  }

  .ml11 .line {
    opacity: 0;
    position: absolute;
    left: 0;
    height: 100%;
    width: 3px;
    background-color: var(--primary);
    transform-origin: 0 50%;
    transition: background-color 0.3s ease;
  }

  .dark .ml11 .line {
    background-color: var(--text-secondary);
  }

  .ml11 .line1 {
    top: 0;
    left: 0;
  }

  /* Hide the full name until JS splits it — prevents a flash of static text on slow loads. */
  .ml11 .letters {
    opacity: 0;
  }

  .ml11 .letters.is-split {
    opacity: 1;
  }

  .ml11 :global(.letter) {
    display: inline-block;
    line-height: 1em;
    opacity: 0;
  }

  .hero-enter {
    opacity: 0;
  }

  :global(html.hero-ready) .hero-enter,
  :global(html.hero-ready) .ml11 .letters,
  :global(html.hero-ready) .ml11 :global(.letter) {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .ml11 .letters,
    .ml11 :global(.letter),
    .hero-enter {
      opacity: 1;
      transform: none;
    }

    .ml11 .line {
      display: none;
    }
  }
</style>
