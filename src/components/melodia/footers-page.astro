---
import Layout from "../../layouts/Layout.astro";
import { getLocaleFromPath, getLocalizedPath } from "../../utils/i18n";

const locale = getLocaleFromPath(Astro.url.pathname);
const melodiaHref = getLocalizedPath("/melodia", locale);
---

<Layout
  title="Melodia footers — Code with CZ"
  description="Footer layout and color directions for Melodía de Bolivia."
  url={Astro.url.href}
  ambientSubtle
>
  <div class="melodia-footers relative z-10 mx-auto min-h-dvh max-w-[1400px] px-4 pb-8 pt-24 font-sans sm:px-6 sm:pt-28">
    <main role="main">
      <div class="mb-5 flex flex-wrap items-end justify-between gap-4">
        <div class="max-w-2xl">
          <p class="text-sm font-semibold tracking-wide" style="color: var(--primary);">Melodia</p>
          <h1 class="mt-1 text-2xl font-bold tracking-tight sm:text-3xl" style="color: var(--text-primary);">
            Footer direction preview
          </h1>
          <p class="mt-2 text-sm leading-relaxed sm:text-base" style="color: var(--text-secondary);">
            Client review: three footer layouts × three Melodía color palettes. Switch layout, theme, and web/mobile
            inside the preview — these colors are Melodia’s, not this site’s.
          </p>
        </div>
        <p class="text-sm">
          <a
            href={melodiaHref}
            data-localized-href="/melodia"
            class="underline-offset-2 hover:underline"
            style="color: var(--text-muted);"
          >
            ← Back to Melodia
          </a>
        </p>
      </div>

      <div
        data-melodia-footers
        class="melodia-footers__frame overflow-hidden rounded-2xl border"
        style="border-color: var(--border-subtle); background: #0a0a0a;"
      >
        <iframe
          title="Melodía de Bolivia — footer layout and theme preview"
          src="/melodia/footer-theme-playground.html"
          class="melodia-footers__iframe block w-full border-0"
          loading="eager"
        ></iframe>
      </div>

      <p class="mt-3 text-center text-xs" style="color: var(--text-muted);">
        Prefer fullscreen?
        <a
          href="/melodia/footer-theme-playground.html"
          target="_blank"
          rel="noreferrer"
          class="underline-offset-2 hover:underline"
          style="color: var(--primary);"
        >
          Open the playground alone
        </a>
      </p>
    </main>
  </div>
</Layout>

<style>
  .melodia-footers__iframe {
    height: min(920px, calc(100dvh - 11rem));
    min-height: 640px;
  }

  @media (max-width: 767px) {
    .melodia-footers__iframe {
      height: calc(100dvh - 9.5rem);
      min-height: 520px;
    }
  }
</style>
