---
import { getLocaleFromPath, getLocalizedPath, getPathWithoutLocale, getTranslation } from "../utils/i18n";

interface Props {
  lockDark?: boolean;
}

const { lockDark = false } = Astro.props;

const currentLocale = getLocaleFromPath(Astro.url.pathname);
const t = (key: string) => getTranslation(currentLocale, key);
const pathWithoutLocale = getPathWithoutLocale(Astro.url.pathname);
const isHome = pathWithoutLocale === "/" || pathWithoutLocale === "";
const isServices = pathWithoutLocale.startsWith("/services");
---

<header class="site-nav-wrap">
  <div class="site-nav">
    <div data-nav-utils class="nav-utils">
      <div data-language-switcher class="nav-lang">
        <a
          href={getLocalizedPath(pathWithoutLocale, "en")}
          data-locale="en"
          class:list={["nav-lang__link", { "is-active": currentLocale === "en" }]}
          aria-label="Switch to English"
          aria-current={currentLocale === "en" ? "true" : undefined}
        >
          EN
        </a>
        <span class="nav-lang__slash">/</span>
        <a
          href={getLocalizedPath(pathWithoutLocale, "es")}
          data-locale="es"
          class:list={["nav-lang__link", { "is-active": currentLocale === "es" }]}
          aria-label="Switch to Español"
          aria-current={currentLocale === "es" ? "true" : undefined}
        >
          ES
        </a>
      </div>

      {!lockDark && (
        <button
          type="button"
          data-theme-toggle
          class="nav-theme"
          aria-label="Toggle theme"
          title="Toggle theme"
        >
          <svg
            class="nav-theme__icon nav-theme__icon--sun"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
          </svg>
          <svg
            class="nav-theme__icon nav-theme__icon--moon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8Z"></path>
          </svg>
        </button>
      )}
    </div>

    <button
      type="button"
      class="nav-toggle"
      data-nav-toggle
      aria-expanded="false"
      aria-controls="site-menu"
      data-i18n-aria="navigation.menu"
      aria-label={t("navigation.menu")}
    >
      <span class="nav-toggle__bars" aria-hidden="true">
        <span></span>
        <span></span>
      </span>
    </button>

    <div class="site-nav__end" id="site-menu">
      <nav class="site-nav__links" aria-label="Primary">
        <a
          href={getLocalizedPath("/", currentLocale)}
          data-localized-href="/"
          class:list={["nav-link", { "is-active": isHome }]}
          aria-current={isHome ? "page" : undefined}
        >
          <span data-i18n="navigation.home">{t("navigation.home")}</span>
        </a>
        <a
          href={getLocalizedPath("/services", currentLocale)}
          data-localized-href="/services"
          class:list={["nav-link", { "is-active": isServices }]}
          aria-current={isServices ? "page" : undefined}
        >
          <span data-i18n="navigation.services">{t("navigation.services")}</span>
        </a>
        <button
          type="button"
          class="nav-link is-disabled"
          data-nav="blog"
          disabled
          aria-disabled="true"
          title={t("navigation.comingSoon")}
          data-i18n-title="navigation.comingSoon"
        >
          <span data-i18n="navigation.blog">{t("navigation.blog")}</span>
          <span class="nav-soon" data-i18n="navigation.soon">{t("navigation.soon")}</span>
        </button>
      </nav>
    </div>
  </div>
</header>

<script>
  import anime from "animejs";
  import { getLocaleFromPath, getTranslation } from "../utils/i18n";
  import { initLocaleSwitcher } from "../utils/apply-locale";
  import { initThemeToggle } from "../utils/theme";

  initLocaleSwitcher();
  initThemeToggle();

  const navWrap = document.querySelector<HTMLElement>(".site-nav-wrap");
  const nav = document.querySelector<HTMLElement>(".site-nav");
  const toggle = document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
  const menu = document.getElementById("site-menu");
  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const compactQuery = window.matchMedia("(max-width: 767px)");

  function menuLabel(open: boolean) {
    return getTranslation(getLocaleFromPath(window.location.pathname), open ? "navigation.closeMenu" : "navigation.menu");
  }

  function setMenuOpen(open: boolean) {
    nav?.classList.toggle("is-open", open);
    toggle?.setAttribute("aria-expanded", open ? "true" : "false");
    toggle?.setAttribute("aria-label", menuLabel(open));
    document.body.classList.toggle("nav-locked", open);
  }

  function settleNavIntro() {
    if (!nav || nav.classList.contains("is-intro-done")) return;
    nav.querySelectorAll<HTMLElement>(".nav-toggle, .nav-link, .nav-utils").forEach((el) => {
      el.style.removeProperty("opacity");
      el.style.removeProperty("transform");
    });
    nav.classList.add("is-intro-done");
  }

  if (nav) {
    if (prefersReducedMotion) {
      settleNavIntro();
    } else {
      const introItems = compactQuery.matches
        ? [toggle, nav.querySelector(".nav-utils")]
        : [...nav.querySelectorAll(".nav-link"), nav.querySelector(".nav-utils")];

      const items = introItems.filter((el): el is HTMLElement => el instanceof HTMLElement);

      items.forEach((el) => {
        el.style.opacity = "0";
        el.style.transform = "translateY(-10px)";
      });

      // If anime never ticks (background tab, blocked rAF, etc.), still reveal the nav.
      const introFallback = window.setTimeout(settleNavIntro, 1200);

      anime({
        targets: items,
        opacity: 1,
        translateY: 0,
        delay: anime.stagger(70, { start: 60 }),
        duration: 560,
        easing: "easeOutExpo",
        complete: () => {
          window.clearTimeout(introFallback);
          settleNavIntro();
        },
      });
    }
  }

  function syncScrolled() {
    navWrap?.classList.toggle("is-scrolled", window.scrollY > 4);
  }

  syncScrolled();
  window.addEventListener("scroll", syncScrolled, { passive: true });

  toggle?.addEventListener("click", () => {
    setMenuOpen(!nav?.classList.contains("is-open"));
  });

  menu?.addEventListener("click", (event) => {
    const target = event.target as HTMLElement | null;
    const item = target?.closest<HTMLElement>(
      "a.nav-link, button.nav-link:not(.is-disabled):not(:disabled), .nav-lang__link, .nav-theme"
    );
    if (item) setMenuOpen(false);
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && nav?.classList.contains("is-open")) {
      setMenuOpen(false);
      toggle?.focus();
    }
  });

  document.addEventListener("click", (event) => {
    const target = event.target as Node | null;
    if (!nav?.classList.contains("is-open")) return;
    if (target && !nav.contains(target)) setMenuOpen(false);
  });

  compactQuery.addEventListener("change", (event) => {
    if (!event.matches) setMenuOpen(false);
  });
</script>

<style>
  .site-nav-wrap {
    position: fixed;
    top: 0;
    right: 0;
    left: 0;
    z-index: 40;
    display: flex;
    justify-content: center;
    padding: 14px 16px 20px;
    pointer-events: none;
  }

  /* Solid canvas behind the bar once the page scrolls, so content never reads through it */
  .site-nav-wrap::before {
    content: "";
    position: absolute;
    inset: 0 0 0 0;
    background: linear-gradient(
      to bottom,
      var(--canvas) 0%,
      var(--canvas) calc(100% - 22px),
      transparent 100%
    );
    opacity: 0;
    pointer-events: none;
    transition: opacity 200ms ease;
  }

  .site-nav-wrap.is-scrolled::before {
    opacity: 1;
  }

  .site-nav {
    pointer-events: auto;
    position: relative;
    display: flex;
    width: min(1180px, 100%);
    min-height: 64px;
    align-items: stretch;
    justify-content: flex-start;
    gap: 4px;
    padding: 0 4px;
  }

  .site-nav__end {
    display: flex;
    min-width: 0;
    flex: 1;
    align-items: stretch;
    justify-content: flex-start;
    gap: 4px;
    order: 1;
  }

  [data-nav-utils] {
    order: 2;
  }

  .nav-toggle {
    order: 3;
  }

  .site-nav:not(.is-intro-done) .nav-toggle,
  .site-nav:not(.is-intro-done) .nav-link,
  .site-nav:not(.is-intro-done) .nav-utils {
    opacity: 0;
  }

  .site-nav.is-intro-done .nav-toggle,
  .site-nav.is-intro-done .nav-link:not(.is-disabled):not(:disabled),
  .site-nav.is-intro-done .nav-utils {
    opacity: 1;
    transform: none;
  }

  .site-nav.is-intro-done .nav-link.is-disabled,
  .site-nav.is-intro-done .nav-link:disabled {
    opacity: 1;
    transform: none;
  }

  .site-nav__links {
    display: flex;
    align-items: stretch;
    gap: 6px;
  }

  .nav-toggle {
    display: none;
    width: 44px;
    height: 44px;
    flex-shrink: 0;
    align-self: center;
    place-items: center;
    border: 0;
    border-radius: 10px;
    background: transparent;
    color: var(--text-primary);
    cursor: pointer;
    appearance: none;
    padding: 0;
  }

  .nav-toggle:hover {
    background: var(--surface-quiet);
  }

  .nav-toggle__bars {
    position: relative;
    display: block;
    width: 16px;
    height: 12px;
  }

  .nav-toggle__bars span {
    position: absolute;
    left: 0;
    right: 0;
    height: 1.5px;
    border-radius: 999px;
    background: currentColor;
    transition: transform 220ms ease, top 220ms ease;
  }

  .nav-toggle__bars span:first-child {
    top: 3px;
  }

  .nav-toggle__bars span:last-child {
    top: 9px;
  }

  .site-nav.is-open .nav-toggle__bars span:first-child {
    top: 6px;
    transform: rotate(45deg);
  }

  .site-nav.is-open .nav-toggle__bars span:last-child {
    top: 6px;
    transform: rotate(-45deg);
  }

  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 62px;
    padding: 0 16px;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: var(--text-muted);
    font-family: inherit;
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 0.005em;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    appearance: none;
    cursor: pointer;
    transition: color 180ms ease;
  }

  /* Active underline */
  .nav-link::after {
    content: "";
    position: absolute;
    right: 16px;
    bottom: 12px;
    left: 16px;
    height: 2px;
    border-radius: 999px;
    background: var(--primary);
    opacity: 0;
    transform: scaleX(0.4);
    transition:
      opacity 200ms ease,
      transform 260ms cubic-bezier(0.2, 0.75, 0.3, 1);
  }

  .nav-link:hover {
    color: var(--text-primary);
  }

  .nav-link.is-active {
    color: var(--primary);
  }

  .nav-link.is-active::after {
    opacity: 1;
    transform: none;
  }

  :global(html.dark) .nav-link {
    color: color-mix(in srgb, var(--text-primary) 72%, transparent);
  }

  :global(html.dark) .nav-link:hover {
    color: var(--text-primary);
  }

  :global(html.dark) .nav-link.is-active {
    color: var(--primary);
  }

  :global(html.dark) .nav-link.is-active::after {
    box-shadow: 0 0 10px color-mix(in srgb, var(--primary) 70%, transparent);
  }

  .nav-utils {
    display: flex;
    align-items: center;
    gap: 18px;
    flex-shrink: 0;
  }

  .nav-link.is-disabled,
  .nav-link:disabled,
  .nav-link.is-disabled:hover,
  .nav-link:disabled:hover,
  :global(html.dark) .nav-link:disabled,
  :global(html.dark) .nav-link:disabled:hover {
    color: var(--text-muted);
    background: transparent;
    cursor: default;
  }

  .nav-soon {
    margin-left: 7px;
    padding: 3px 7px;
    border-radius: 999px;
    background: var(--primary-surface);
    color: var(--primary);
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.02em;
    line-height: 1;
  }

  .nav-lang {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .nav-lang__link {
    color: var(--text-muted);
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 0.02em;
    line-height: 1;
    padding: 2px 2px;
    transition: color 180ms ease;
  }

  .nav-lang__link:hover {
    color: var(--text-primary);
  }

  .nav-lang__link.is-active {
    color: var(--primary);
    font-weight: 700;
  }

  .nav-lang__slash {
    color: var(--text-muted);
    opacity: 0.5;
    font-size: 14px;
    font-weight: 400;
    line-height: 1;
  }

  .nav-theme {
    display: grid;
    width: 38px;
    height: 38px;
    place-items: center;
    border: 0;
    border-radius: 10px;
    background: transparent;
    color: var(--text-primary);
    cursor: pointer;
    transition:
      background 180ms ease,
      color 180ms ease;
  }

  .nav-theme:hover {
    background: var(--surface-quiet);
    color: var(--primary);
  }

  .nav-theme__icon {
    width: 24px;
    height: 24px;
    grid-area: 1 / 1;
    transition:
      opacity 200ms ease,
      transform 200ms ease;
  }

  .nav-theme__icon--moon {
    opacity: 0;
    transform: rotate(-45deg) scale(0.6);
  }

  :global(html.dark) .nav-theme__icon--sun {
    opacity: 0;
    transform: rotate(45deg) scale(0.6);
  }

  :global(html.dark) .nav-theme__icon--moon {
    opacity: 1;
    transform: none;
  }

  @media (max-width: 767px) {
    .site-nav-wrap {
      padding: 10px 12px 0;
    }

    .site-nav {
      min-height: 56px;
      align-items: center;
      gap: 6px;
      padding: 0;
    }

    .nav-toggle {
      display: grid;
      order: 1;
      width: 40px;
      height: 40px;
    }

    .nav-utils {
      order: 2;
      margin-left: auto;
      gap: 10px;
    }

    .nav-lang__link {
      font-size: 13px;
    }

    .nav-theme {
      width: 34px;
      height: 34px;
    }

    .nav-theme__icon {
      width: 20px;
      height: 20px;
    }

    .site-nav__end {
      order: 3;
      position: absolute;
      top: calc(100% + 8px);
      right: 0;
      left: 0;
      z-index: 41;
      display: none;
      flex: none;
      flex-direction: column;
      align-items: stretch;
      gap: 2px;
      padding: 8px;
      border-radius: 14px;
      background: color-mix(in srgb, var(--canvas) 92%, white);
      border: 1px solid var(--glass-border);
      box-shadow:
        0 18px 40px rgba(15, 23, 42, 0.14),
        inset 0 1px 0 rgba(255, 255, 255, 0.55);
      backdrop-filter: blur(22px);
      -webkit-backdrop-filter: blur(22px);
    }

    :global(html.dark) .site-nav__end {
      background: color-mix(in srgb, var(--canvas) 88%, rgb(30 41 59));
      box-shadow:
        0 18px 40px rgba(0, 0, 0, 0.34),
        inset 0 1px 0 rgba(255, 255, 255, 0.05);
    }

    .site-nav.is-open .site-nav__end {
      display: flex;
    }

    .site-nav__links {
      flex-direction: column;
      align-items: center;
      gap: 2px;
      width: 100%;
      padding: 4px 0;
    }

    .nav-link {
      justify-content: center;
      min-height: 46px;
      padding: 0 16px;
      font-size: 16px;
    }

    .nav-link::after {
      bottom: 8px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-nav .nav-toggle,
    .site-nav .nav-link:not(.is-disabled):not(:disabled),
    .site-nav .nav-utils {
      opacity: 1;
      transform: none;
    }

    .site-nav .nav-link.is-disabled,
    .site-nav .nav-link:disabled {
      opacity: 1;
      transform: none;
    }
  }
</style>
