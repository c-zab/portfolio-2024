---
import {
  siAstro,
  siClaris,
  siDocker,
  siExpress,
  siGit,
  siGraphql,
  siJavascript,
  siMongodb,
  siMysql,
  siNextdotjs,
  siNodedotjs,
  siPostgresql,
  siReact,
  siRedis,
  siTailwindcss,
  siTypescript,
  siVercel,
  siVuedotjs,
} from "simple-icons";
import { getLocaleFromPath, getTranslation } from "../utils/i18n";

type Tool = {
  label: string;
  path: string;
  hoverLight: string;
  hoverDark: string;
  motion: string;
};

const locale = getLocaleFromPath(Astro.url.pathname);
const t = (key: string) => getTranslation(locale, key);

const tools: Tool[] = [
  { label: "React", path: siReact.path, hoverLight: "#0284C7", hoverDark: "#7DD3FC", motion: "spin" },
  { label: "Vue", path: siVuedotjs.path, hoverLight: "#15803D", hoverDark: "#4ADE80", motion: "pop" },
  { label: "Next.js", path: siNextdotjs.path, hoverLight: "#111111", hoverDark: "#F8FAFC", motion: "nudge" },
  { label: "TypeScript", path: siTypescript.path, hoverLight: "#1D4ED8", hoverDark: "#60A5FA", motion: "tilt" },
  { label: "Node.js", path: siNodedotjs.path, hoverLight: "#3F6212", hoverDark: "#A3E635", motion: "bounce" },
  { label: "Express", path: siExpress.path, hoverLight: "#1C1917", hoverDark: "#D6D3D1", motion: "stretch" },
  { label: "MongoDB", path: siMongodb.path, hoverLight: "#166534", hoverDark: "#86EFAC", motion: "wiggle" },
  { label: "PostgreSQL", path: siPostgresql.path, hoverLight: "#1E3A8A", hoverDark: "#A5B4FC", motion: "hop" },
  { label: "Docker", path: siDocker.path, hoverLight: "#0369A1", hoverDark: "#38BDF8", motion: "float" },
  { label: "Git", path: siGit.path, hoverLight: "#C2410C", hoverDark: "#FB7185", motion: "roll" },
  { label: "Vercel", path: siVercel.path, hoverLight: "#111111", hoverDark: "#E2E8F0", motion: "lift" },
  { label: "Tailwind", path: siTailwindcss.path, hoverLight: "#0E7490", hoverDark: "#22D3EE", motion: "wave" },
  { label: "JavaScript", path: siJavascript.path, hoverLight: "#A16207", hoverDark: "#FDE047", motion: "jiggle" },
  { label: "GraphQL", path: siGraphql.path, hoverLight: "#BE185D", hoverDark: "#F9A8D4", motion: "swirl" },
  { label: "Redis", path: siRedis.path, hoverLight: "#B91C1C", hoverDark: "#FCA5A5", motion: "pulse" },
  { label: "FileMaker", path: siClaris.path, hoverLight: "#5B21B6", hoverDark: "#D8B4FE", motion: "flip" },
  { label: "MySQL", path: siMysql.path, hoverLight: "#0F766E", hoverDark: "#2DD4BF", motion: "bob" },
  { label: "Astro", path: siAstro.path, hoverLight: "#7E22CE", hoverDark: "#E9D5FF", motion: "sparkle" },
];

const games = ["Smash Bros", "Rocket League", "Clash Royale", "PUBG"];
const gamesTrack = [...games, ...games, ...games];
---

<section data-tech-marquee class="hero-enter w-full pt-10">
  <h2 class="sr-only" data-i18n="techStack.toolsLabel">{t("techStack.toolsLabel")}</h2>
  <ul class="sr-only">
    {tools.map((tool) => <li>{tool.label}</li>)}
  </ul>
  <p class="sr-only" data-i18n="techStack.gamesLabel">{t("techStack.gamesLabel")}</p>
  <ul class="sr-only">
    {games.map((game) => <li>{game}</li>)}
  </ul>

  <div class="marquee marquee-tools" aria-hidden="true">
    <div class="marquee-track">
      {
        [tools, tools].map((group, groupIndex) => (
          <div class:list={["marquee-group", { "marquee-clone": groupIndex === 1 }]}>
            {group.map((tool) => (
              <span
                class="tech-chip"
                style={`--brand-light: ${tool.hoverLight}; --brand-dark: ${tool.hoverDark}`}
                data-motion={tool.motion}
              >
                <svg viewBox="0 0 24 24" class="h-6 w-6" aria-hidden="true">
                  <path fill="currentColor" d={tool.path} />
                </svg>
                <span>{tool.label}</span>
              </span>
            ))}
          </div>
        ))
      }
    </div>
  </div>

  <div class="marquee marquee-games mt-3" aria-hidden="true">
    <div class="marquee-track marquee-track-reverse">
      {
        [gamesTrack, gamesTrack].map((group, groupIndex) => (
          <div class:list={["marquee-group", { "marquee-clone": groupIndex === 1 }]}>
            {group.map((game, index) => (
              <span class:list={["game-chip", { "marquee-repeat-item": index >= games.length }]}>
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="h-4 w-4"
                  aria-hidden="true"
                >
                  <rect x="2" y="8" width="20" height="10" rx="5"></rect>
                  <path d="M6 13h4M8 11v4"></path>
                  <circle cx="16.2" cy="11.4" r="0.7" fill="currentColor" stroke="none"></circle>
                  <circle cx="18.4" cy="13.4" r="0.7" fill="currentColor" stroke="none"></circle>
                </svg>
                <span>{game}</span>
              </span>
            ))}
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .hero-enter {
    opacity: 0;
  }

  .marquee {
    overflow: hidden;
    mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
  }

  .marquee-track {
    display: flex;
    width: max-content;
    animation: marquee-scroll 42s linear infinite;
    will-change: transform;
  }

  .marquee-track-reverse {
    animation-duration: 56s;
    animation-direction: reverse;
  }

  .marquee:hover .marquee-track {
    animation-play-state: paused;
  }

  .marquee-group {
    display: flex;
    align-items: center;
    gap: 2rem;
    padding-inline: 1rem;
  }

  .tech-chip,
  .game-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    white-space: nowrap;
    user-select: none;
  }

  .tech-chip {
    font-size: 0.85rem;
    font-weight: 600;
    color: color-mix(in srgb, var(--text-muted) 78%, transparent);
    cursor: default;
    transform-origin: center;
    transition:
      color 0.2s ease,
      filter 0.2s ease;
  }

  .dark .tech-chip {
    color: color-mix(in srgb, var(--text-muted) 72%, transparent);
  }

  .tech-chip svg {
    flex-shrink: 0;
    transform-origin: center;
  }

  .tech-chip:hover {
    color: var(--brand-light);
    filter: drop-shadow(0 0 8px color-mix(in srgb, var(--brand-light) 45%, transparent));
  }

  .dark .tech-chip:hover {
    color: var(--brand-dark);
    filter: drop-shadow(0 0 10px color-mix(in srgb, var(--brand-dark) 55%, transparent));
  }

  .tech-chip[data-motion="spin"]:hover svg {
    animation: chip-spin 0.7s ease-in-out;
  }

  .tech-chip[data-motion="pop"]:hover {
    animation: chip-pop 0.4s ease;
  }

  .tech-chip[data-motion="nudge"]:hover {
    animation: chip-nudge 0.45s ease;
  }

  .tech-chip[data-motion="tilt"]:hover {
    animation: chip-tilt 0.4s ease;
  }

  .tech-chip[data-motion="bounce"]:hover svg {
    animation: chip-bounce 0.5s ease;
  }

  .tech-chip[data-motion="stretch"]:hover {
    animation: chip-stretch 0.4s ease;
  }

  .tech-chip[data-motion="wiggle"]:hover svg {
    animation: chip-wiggle 0.5s ease;
  }

  .tech-chip[data-motion="hop"]:hover {
    animation: chip-hop 0.45s ease;
  }

  .tech-chip[data-motion="float"]:hover svg {
    animation: chip-float 0.8s ease-in-out infinite;
  }

  .tech-chip[data-motion="roll"]:hover svg {
    animation: chip-roll 0.55s ease;
  }

  .tech-chip[data-motion="lift"]:hover {
    animation: chip-lift 0.4s ease;
  }

  .tech-chip[data-motion="wave"]:hover svg {
    animation: chip-wave 0.6s ease-in-out infinite;
  }

  .tech-chip[data-motion="jiggle"]:hover {
    animation: chip-jiggle 0.5s ease;
  }

  .tech-chip[data-motion="swirl"]:hover svg {
    animation: chip-swirl 0.65s ease-in-out;
  }

  .tech-chip[data-motion="pulse"]:hover {
    animation: chip-pulse 0.45s ease infinite;
  }

  .tech-chip[data-motion="flip"]:hover svg {
    animation: chip-flip 0.55s ease;
  }

  .tech-chip[data-motion="bob"]:hover {
    animation: chip-bob 0.6s ease-in-out;
  }

  .tech-chip[data-motion="sparkle"]:hover {
    animation: chip-sparkle 0.55s ease;
  }

  @keyframes chip-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes chip-pop {
    0%,
    100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.16);
    }
  }

  @keyframes chip-nudge {
    0%,
    100% {
      transform: translateX(0);
    }
    50% {
      transform: translateX(6px);
    }
  }

  @keyframes chip-tilt {
    0%,
    100% {
      transform: rotate(0deg);
    }
    40% {
      transform: rotate(-10deg);
    }
    70% {
      transform: rotate(6deg);
    }
  }

  @keyframes chip-bounce {
    0%,
    100% {
      transform: translateY(0);
    }
    40% {
      transform: translateY(-7px);
    }
    70% {
      transform: translateY(-2px);
    }
  }

  @keyframes chip-stretch {
    0%,
    100% {
      transform: scaleX(1);
    }
    50% {
      transform: scaleX(1.18);
    }
  }

  @keyframes chip-wiggle {
    0%,
    100% {
      transform: rotate(0deg);
    }
    25% {
      transform: rotate(-14deg);
    }
    75% {
      transform: rotate(14deg);
    }
  }

  @keyframes chip-hop {
    0%,
    100% {
      transform: translateY(0) scale(1);
    }
    40% {
      transform: translateY(-8px) scale(1.06);
    }
  }

  @keyframes chip-float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-6px);
    }
  }

  @keyframes chip-roll {
    0% {
      transform: rotate(0deg);
    }
    100% {
      transform: rotate(360deg);
    }
  }

  @keyframes chip-lift {
    0%,
    100% {
      transform: translateY(0) scale(1);
    }
    50% {
      transform: translateY(-5px) scale(1.08);
    }
  }

  @keyframes chip-wave {
    0%,
    100% {
      transform: rotate(0deg);
    }
    25% {
      transform: rotate(-18deg);
    }
    75% {
      transform: rotate(18deg);
    }
  }

  @keyframes chip-jiggle {
    0%,
    100% {
      transform: rotate(0deg);
    }
    20% {
      transform: rotate(-8deg) translateX(-2px);
    }
    40% {
      transform: rotate(8deg) translateX(2px);
    }
    60% {
      transform: rotate(-5deg);
    }
    80% {
      transform: rotate(5deg);
    }
  }

  @keyframes chip-swirl {
    0% {
      transform: rotate(0deg) scale(1);
    }
    50% {
      transform: rotate(180deg) scale(1.12);
    }
    100% {
      transform: rotate(360deg) scale(1);
    }
  }

  @keyframes chip-pulse {
    0%,
    100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.2);
    }
  }

  @keyframes chip-flip {
    0% {
      transform: rotateY(0deg);
    }
    100% {
      transform: rotateY(360deg);
    }
  }

  @keyframes chip-bob {
    0%,
    100% {
      transform: translateY(0) rotate(0deg);
    }
    50% {
      transform: translateY(-5px) rotate(-6deg);
    }
  }

  @keyframes chip-sparkle {
    0%,
    100% {
      transform: scale(1) rotate(0deg);
    }
    35% {
      transform: scale(1.2) rotate(-8deg);
    }
    70% {
      transform: scale(1.08) rotate(8deg);
    }
  }

  .game-chip {
    font-size: 0.72rem;
    font-weight: 500;
    color: color-mix(in srgb, var(--text-muted) 70%, transparent);
  }

  .dark .game-chip {
    color: color-mix(in srgb, var(--text-muted) 45%, transparent);
  }

  @keyframes marquee-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-enter {
      opacity: 1;
    }

    .marquee {
      mask-image: none;
    }

    .marquee-track,
    .marquee-track-reverse {
      animation: none;
      flex-wrap: wrap;
      justify-content: center;
      width: 100%;
      row-gap: 0.75rem;
    }

    .marquee-clone,
    .marquee-repeat-item {
      display: none;
    }

    .tech-chip:hover,
    .tech-chip:hover svg {
      animation: none;
      transform: none;
    }
  }
</style>
